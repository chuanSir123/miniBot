        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>鹈鹕骑自行车 🐦🚴</title>\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    height: 100%;\n    background: linear-gradient(#8fd3ff 0%, #bfe6ff 55%, #d8f0ff 100%);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    overflow: hidden;\n    font-family: \"Segoe UI\", sans-serif;\n  }\n  .stage {\n    width: 900px;\n    max-width: 95vw;\n  }\n  .title {\n    text-align: center;\n    color: #2c6e9e;\n    font-size: 26px;\n    font-weight: 700;\n    margin-bottom: 4px;\n    text-shadow: 0 2px 0 rgba(255,255,255,.6);\n  }\n  /* 整体上下轻微颠簸 */\n  @keyframes bob {\n    0%, 100% { transform: translateY(0); }\n    50%     { transform: translateY(-6px); }\n  }\n  .rider {\n    animation: bob 0.9s ease-in-out infinite;\n  }\n  /* 车轮旋转 */\n  @keyframes spin { to { transform: rotate(360deg); } }\n  .wheel {\n    transform-box: fill-box;\n    transform-origin: center;\n    animation: spin 1.1s linear infinite;\n  }\n  /* 曲柄+脚踏旋转 */\n  @keyframes crank { to { transform: rotate(360deg); } }\n  .crank {\n    transform-box: fill-box;\n    transform-origin: center;\n    animation: crank 1.1s linear infinite;\n  }\n  /* 翅膀前后摆动 */\n  @keyframes flap {\n    0%, 100% { transform: rotate(-6deg); }\n    50%     { transform: rotate(10deg); }\n  }\n  .wing {\n    transform-box: fill-box;\n    transform-origin: 20% 30%;\n    animation: flap 0.9s ease-in-out infinite;\n  }\n  /* 云朵/地面移动 */\n  @keyframes moveGround { to { transform: translateX(-200px); } }\n  .ground { animation: moveGround 1.2s linear infinite; }\n  @keyframes moveCloud { from { transform: translateX(0); } to { transform: translateX(-1000px); } }\n  .clouds { animation: moveCloud 12s linear infinite; }\n</style>\n</head>\n<body>\n  <div class=\"stage\">\n    <div class=\"title\">🐦 鹈鹕骑自行车 🚴</div>\n    <svg viewBox=\"0 0 900 500\" width=\"100%\" xmlns=\"http://www.w3.org/2000/svg\">\n\n      <!-- 云朵 -->\n      <g class=\"clouds\" fill=\"#ffffff\" opacity=\"0.9\">\n        <g>\n          <ellipse cx=\"120\" cy=\"90\" rx=\"45\" ry=\"24\"/>\n          <ellipse cx=\"160\" cy=\"80\" rx=\"35\" ry=\"22\"/>\n          <ellipse cx=\"90\" cy=\"80\" rx=\"30\" ry=\"20\"/>\n        </g>\n        <g>\n          <ellipse cx=\"420\" cy=\"60\" rx=\"50\" ry=\"26\"/>\n          <ellipse cx=\"470\" cy=\"50\" rx=\"38\" ry=\"22\"/>\n          <ellipse cx=\"380\" cy=\"52\" rx=\"32\" ry=\"20\"/>\n        </g>\n        <g>\n          <ellipse cx=\"720\" cy=\"100\" rx=\"48\" ry=\"24\"/>\n          <ellipse cx=\"765\" cy=\"90\" rx=\"36\" ry=\"22\"/>\n          <ellipse cx=\"685\" cy=\"92\" rx=\"30\" ry=\"20\"/>\n        </g>\n        <!-- 复制一份用于无缝循环 -->\n        <g>\n          <ellipse cx=\"1120\" cy=\"90\" rx=\"45\" ry=\"24\"/>\n          <ellipse cx=\"1160\" cy=\"80\" rx=\"35\" ry=\"22\"/>\n          <ellipse cx=\"1090\" cy=\"80\" rx=\"30\" ry=\"20\"/>\n        </g>\n        <g>\n          <ellipse cx=\"1420\" cy=\"60\" rx=\"50\" ry=\"26\"/>\n          <ellipse cx=\"1470\" cy=\"50\" rx=\"38\" ry=\"22\"/>\n          <ellipse cx=\"1380\" cy=\"52\" rx=\"32\" ry=\"20\"/>\n        </g>\n        <g>\n          <ellipse cx=\"1720\" cy=\"100\" rx=\"48\" ry=\"24\"/>\n          <ellipse cx=\"1765\" cy=\"90\" rx=\"36\" ry=\"22\"/>\n          <ellipse cx=\"1685\" cy=\"92\" rx=\"30\" ry=\"20\"/>\n        </g>\n      </g>\n\n      <!-- 地面 -->\n      <rect x=\"0\" y=\"400\" width=\"900\" height=\"100\" fill=\"#7ecb6b\"/>\n      <g class=\"ground\" fill=\"#5aa84c\">\n        <g id=\"grass\">\n          <line x1=\"40\"  y1=\"405\" x2=\"40\"  y2=\"430\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"120\" y1=\"405\" x2=\"120\" y2=\"428\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"220\" y1=\"405\" x2=\"220\" y2=\"432\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"320\" y1=\"405\" x2=\"320\" y2=\"426\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"420\" y1=\"405\" x2=\"420\" y2=\"430\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"520\" y1=\"405\" x2=\"520\" y2=\"428\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"620\" y1=\"405\" x2=\"620\" y2=\"432\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"720\" y1=\"405\" x2=\"720\" y2=\"426\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"820\" y1=\"405\" x2=\"820\" y2=\"430\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <!-- 复制一份 -->\n          <line x1=\"240\"  y1=\"405\" x2=\"240\"  y2=\"430\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"340\"  y1=\"405\" x2=\"340\"  y2=\"428\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"440\"  y1=\"405\" x2=\"440\"  y2=\"432\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"540\"  y1=\"405\" x2=\"540\"  y2=\"426\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"640\"  y1=\"405\" x2=\"640\"  y2=\"430\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"740\"  y1=\"405\" x2=\"740\"  y2=\"428\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"840\"  y1=\"405\" x2=\"840\"  y2=\"432\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"940\"  y1=\"405\" x2=\"940\"  y2=\"426\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n          <line x1=\"1040\" y1=\"405\" x2=\"1040\" y2=\"430\" stroke=\"#4e9a42\" stroke-width=\"4\"/>\n        </g>\n      </g>\n\n      <!-- 阴影 -->\n      <ellipse cx=\"450\" cy=\"410\" rx=\"150\" ry=\"16\" fill=\"#000000\" opacity=\"0.12\"/>\n\n      <!-- ===== 自行车 + 鹈鹕 (整体上下颠簸) ===== -->\n      <g class=\"rider\">\n\n        <!-- 后轮 -->\n        <g class=\"wheel\">\n          <circle cx=\"330\" cy=\"340\" r=\"62\" fill=\"none\" stroke=\"#333\" stroke-width=\"8\"/>\n          <circle cx=\"330\" cy=\"340\" r=\"54\" fill=\"none\" stroke=\"#555\" stroke-width=\"2\"/>\n          <g stroke=\"#888\" stroke-width=\"3\">\n            <line x1=\"330\" y1=\"286\" x2=\"330\" y2=\"394\"/>\n            <line x1=\"276\" y1=\"340\" x2=\"384\" y2=\"340\"/>\n            <line x1=\"292\" y1=\"302\" x2=\"368\" y2=\"378\"/>\n            <line x1=\"368\" y1=\"302\" x2=\"292\" y2=\"378\"/>\n          </g>\n          <circle cx=\"330\" cy=\"340\" r=\"8\" fill=\"#222\"/>\n        </g>\n\n        <!-- 前轮 -->\n        <g class=\"wheel\">\n          <circle cx=\"620\" cy=\"340\" r=\"62\" fill=\"none\" stroke=\"#333\" stroke-width=\"8\"/>\n          <circle cx=\"620\" cy=\"340\" r=\"54\" fill=\"none\" stroke=\"#555\" stroke-width=\"2\"/>\n          <g stroke=\"#888\" stroke-width=\"3\">\n            <line x1=\"620\" y1=\"286\" x2=\"620\" y2=\"394\"/>\n            <line x1=\"566\" y1=\"340\" x2=\"674\" y2=\"340\"/>\n            <line x1=\"582\" y1=\"302\" x2=\"658\" y2=\"378\"/>\n            <line x1=\"658\" y1=\"302\" x2=\"582\" y2=\"378\"/>\n          </g>\n          <circle cx=\"620\" cy=\"340\" r=\"8\" fill=\"#222\"/>\n        </g>\n\n        <!-- 车架 -->\n        <g stroke=\"#e0483f\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\">\n          <!-- 后轮轴 -> 中轴(脚踏) -->\n          <line x1=\"330\" y1=\"340\" x2=\"450\" y2=\"345\"/>\n          <!-- 中轴 -> 前叉/车把下 -->\n          <line x1=\"450\" y1=\"345\" x2=\"590\" y2=\"250\"/>\n          <!-- 中轴 -> 车把立管 -->\n          <line x1=\"450\" y1=\"345\" x2=\"470\" y2=\"245\"/>\n          <!-- 后轮轴 -> 座管 -->\n          <line x1=\"330\" y1=\"340\" x2=\"360\" y2=\"230\"/>\n          <!-- 座管 -> 车把立管 (上管) -->\n          <line x1=\"360\" y1=\"230\" x2=\"470\" y2=\"245\"/>\n          <!-- 前叉 -->\n          <line x1=\"590\" y1=\"250\" x2=\"620\" y2=\"340\"/>\n        </g>\n\n        <!-- 车座 -->\n        <rect x=\"335\" y=\"218\" width=\"55\" height=\"16\" rx=\"8\" fill=\"#2b2b2b\"/>\n        <!-- 车把 -->\n        <path d=\"M470 245 L500 225 L520 235\" stroke=\"#2b2b2b\" stroke-width=\"9\" fill=\"none\" stroke-linecap=\"round\"/>\n        <circle cx=\"522\" cy=\"236\" r=\"7\" fill=\"#111\"/>\n\n        <!-- 曲柄 + 脚踏 (旋转) -->\n        <g class=\"crank\">\n          <line x1=\"450\" y1=\"345\" x2=\"450\" y2=\"300\" stroke=\"#333\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n          <rect x=\"432\" y=\"292\" width=\"36\" height=\"12\" rx=\"4\" fill=\"#333\"/>\n          <line x1=\"450\" y1=\"345\" x2=\"450\" y2=\"390\" stroke=\"#333\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n          <rect x=\"432\" y=\"382\" width=\"36\" height=\"12\" rx=\"4\" fill=\"#333\"/>\n          <circle cx=\"450\" cy=\"345\" r=\"9\" fill=\"#444\"/>\n        </g>\n\n        <!-- ===== 鹈鹕 ===== -->\n        <!-- 腿 (蹬脚踏) -->\n        <g stroke=\"#f4a83a\" stroke-width=\"9\" stroke-linecap=\"round\" fill=\"none\">\n          <!-- 后腿 -->\n          <path d=\"M430 300 L440 320 L448 335\"/>\n          <!-- 前腿 -->\n          <path d=\"M462 360 L470 340 L455 320\"/>\n        </g>\n\n        <!-- 身体 -->\n        <g>\n          <!-- 尾羽 -->\n          <path d=\"M330 235 Q300 220 295 245 Q315 245 335 250 Z\" fill=\"#ffffff\" stroke=\"#d9d9d9\" stroke-width=\"2\"/>\n          <!-- 身体主体 -->\n          <ellipse cx=\"400\" cy=\"235\" rx=\"70\" ry=\"48\" fill=\"#ffffff\" stroke=\"#dcdcdc\" stroke-width=\"2\"/>\n          <!-- 翅膀 (摆动) -->\n          <g class=\"wing\">\n            <path d=\"M380 220 Q430 200 470 225 Q455 250 405 248 Q385 240 380 220 Z\"\n                  fill=\"#f0f0f0\" stroke=\"#cfcfcf\" stroke-width=\"2\"/>\n          </g>\n          <!-- 脖子 -->\n          <path d=\"M445 215 Q470 180 470 150 Q470 130 460 120\"\n                fill=\"none\" stroke=\"#ffffff\" stroke-width=\"34\" stroke-linecap=\"round\"/>\n          <path d=\"M445 215 Q470 180 470 150 Q470 130 460 120\"\n                fill=\"none\" stroke=\"#e6e6e6\" stroke-width=\"2\" opacity=\"0.5\"/>\n          <!-- 头 -->\n          <circle cx=\"462\" cy=\"112\" r=\"30\" fill=\"#ffffff\" stroke=\"#dcdcdc\" stroke-width=\"2\"/>\n          <!-- 眼