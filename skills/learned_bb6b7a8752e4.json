"-49\" y1=\"-29\" x2=\"49\" y2=\"29\"/>\n        <line x1=\"-29\" y1=\"49\" x2=\"29\" y2=\"-49\"/>\n        <line x1=\"-49\" y1=\"29\" x2=\"49\" y2=\"-29\"/>\n      </g>\n    </g>\n  </defs>\n\n  <!-- 标题 -->\n  <text x=\"450\" y=\"52\" text-anchor=\"middle\" class=\"title\">🐦 鹈鹕骑自行车 🚲</text>\n\n  <!-- 太阳 -->\n  <g>\n    <circle cx=\"810\" cy=\"80\" r=\"34\" fill=\"#ffd54a\"/>\n    <g stroke=\"#ffd54a\" stroke-width=\"5\" stroke-linecap=\"round\">\n      <line x1=\"810\" y1=\"28\" x2=\"810\" y2=\"46\"/>\n      <line x1=\"810\" y1=\"114\" x2=\"810\" y2=\"132\"/>\n      <line x1=\"758\" y1=\"80\" x2=\"776\" y2=\"80\"/>\n      <line x1=\"844\" y1=\"80\" x2=\"862\" y2=\"80\"/>\n      <line x1=\"773\" y1=\"43\" x2=\"785\" y2=\"55\"/>\n      <line x1=\"835\" y1=\"105\" x2=\"847\" y2=\"117\"/>\n      <line x1=\"847\" y1=\"43\" x2=\"835\" y2=\"55\"/>\n      <line x1=\"785\" y1=\"105\" x2=\"773\" y2=\"117\"/>\n    </g>\n  </g>\n\n  <!-- 移动的云朵 -->\n  <g>\n    <use href=\"#cloud\" x=\"120\" y=\"90\">\n      <animate attributeName=\"x\" from=\"120\" to=\"980\" dur=\"16s\" repeatCount=\"indefinite\"/>\n    </use>\n    <use href=\"#cloud\" x=\"420\" y=\"140\">\n      <animate attributeName=\"x\" from=\"420\" to=\"1280\" dur=\"22s\" repeatCount=\"indefinite\"/>\n    </use>\n    <use href=\"#cloud\" x=\"640\" y=\"70\">\n      <animate attributeName=\"x\" from=\"640\" to=\"1500\" dur=\"19s\" repeatCount=\"indefinite\"/>\n    </use>\n  </g>\n\n  <!-- 地面道路 -->\n  <rect x=\"0\" y=\"420\" width=\"900\" height=\"100\" fill=\"#6b8e23\"/>\n  <rect x=\"0\" y=\"420\" width=\"900\" height=\"14\" fill=\"#556b2f\"/>\n  <!-- 马路 -->\n  <rect x=\"0\" y=\"448\" width=\"900\" height=\"72\" fill=\"#4a4a52\"/>\n  <!-- 移动的路面虚线 -->\n  <g fill=\"#f4d03f\">\n    <rect x=\"-60\" y=\"480\" width=\"50\" height=\"9\" rx=\"4\">\n      <animate attributeName=\"x\" from=\"900\" to=\"-120\" dur=\"0.9s\" repeatCount=\"indefinite\"/>\n    </rect>\n    <rect x=\"180\" y=\"480\" width=\"50\" height=\"9\" rx=\"4\">\n      <animate attributeName=\"x\" from=\"1080\" to=\"60\" dur=\"0.9s\" repeatCount=\"indefinite\"/>\n    </rect>\n    <rect x=\"360\" y=\"480\" width=\"50\" height=\"9\" rx=\"4\">\n      <animate attributeName=\"x\" from=\"1260\" to=\"240\" dur=\"0.9s\" repeatCount=\"indefinite\"/>\n    </rect>\n    <rect x=\"540\" y=\"480\" width=\"50\" height=\"9\" rx=\"4\">\n      <animate attributeName=\"x\" from=\"1440\" to=\"420\" dur=\"0.9s\" repeatCount=\"indefinite\"/>\n    </rect>\n    <rect x=\"720\" y=\"480\" width=\"50\" height=\"9\" rx=\"4\">\n      <animate attributeName=\"x\" from=\"1620\" to=\"600\" dur=\"0.9s\" repeatCount=\"indefinite\"/>\n    </rect>\n  </g>\n\n  <!-- 自行车 + 鹈鹕 整体（上下轻微颠簸） -->\n  <g id=\"rider\">\n    <animateTransform attributeName=\"transform\" type=\"translate\"\n      values=\"0 0; 0 -4; 0 0; 0 -3; 0 0\" dur=\"0.5s\" repeatCount=\"indefinite\"/>\n\n    <!-- 后轮 -->\n    <g transform=\"translate(300,420)\">\n      <use href=\"#wheel\">\n        <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0\" to=\"360\" dur=\"0.9s\" repeatCount=\"indefinite\"/>\n      </use>\n    </g>\n    <!-- 前轮 -->\n    <g transform=\"translate(560,420)\">\n      <use href=\"#wheel\">\n        <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0\" to=\"360\" dur=\"0.9s\" repeatCount=\"indefinite\"/>\n      </use>\n    </g>\n\n    <!-- 车架 -->\n    <g stroke=\"#e74c3c\" stroke-width=\"11\" stroke-linecap=\"round\" fill=\"none\">\n      <!-- 后轮中心到曲柄 -->\n      <line x1=\"300\" y1=\"420\" x2=\"430\" y2=\"420\"/>\n      <!-- 曲柄到座管 -->\n      <line x1=\"430\" y1=\"420\" x2=\"400\" y2=\"330\"/>\n      <!-- 座管到后轮中心 -->\n      <line x1=\"400\" y1=\"330\" x2=\"300\" y2=\"420\"/>\n      <!-- 曲柄到前叉 -->\n      <line x1=\"430\" y1=\"420\" x2=\"560\" y2=\"420\"/>\n      <!-- 前叉到车把 -->\n      <line x1=\"560\" y1=\"420\" x2=\"540\" y2=\"320\"/>\n      <!-- 座管到车把 -->\n      <line x1=\"400\" y1=\"330\" x2=\"540\" y2=\"320\"/>\n    </g>\n    <!-- 车座 -->\n    <rect x=\"378\" y=\"318\" width=\"52\" height=\"16\" rx=\"8\" fill=\"#2c3e50\"/>\n    <!-- 车把 -->\n    <g stroke=\"#2c3e50\" stroke-width=\"9\" stroke-linecap=\"round\" fill=\"none\">\n      <path d=\"M540 320 Q560 300 585 305\"/>\n    </g>\n    <!-- 曲柄/脚踏 -->\n    <g>\n      <circle cx=\"430\" cy=\"420\" r=\"12\" fill=\"#2c3e50\"/>\n      <g>\n        <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 430 420\" to=\"360 430 420\" dur=\"0.9s\" repeatCount=\"indefinite\"/>\n        <line x1=\"430\" y1=\"420\" x2=\"430\" y2=\"384\" stroke=\"#2c3e50\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n        <rect x=\"416\" y=\"378\" width=\"28\" height=\"10\" rx=\"4\" fill=\"#111\"/>\n        <line x1=\"430\" y1=\"420\" x2=\"430\" y2=\"456\" stroke=\"#2c3e50\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n        <rect x=\"416\" y=\"452\" width=\"28\" height=\"10\" rx=\"4\" fill=\"#111\"/>\n      </g>\n    </g>\n\n    <!-- ===== 鹈鹕 ===== -->\n    <!-- 尾巴 -->\n    <path d=\"M300 350 Q255 340 235 365 Q265 360 285 372 Z\" fill=\"#f5f0e1\"/>\n    <!-- 身体 -->\n    <ellipse cx=\"360\" cy=\"355\" rx=\"78\" ry=\"52\" fill=\"#fbf7ec\" stroke=\"#d9d2bd\" stroke-width=\"3\"/>\n    <!-- 翅膀（扑动） -->\n    <g>\n      <animateTransform attributeName=\"transform\" type=\"rotate\"\n        values=\"0 360 350; -18 360 350; 0 360 350\" dur=\"0.5s\" repeatCount=\"indefinite\"/>\n      <path d=\"M330 350 Q300 300 350 300 Q395 315 385 360 Q350 380 330 350 Z\"\n        fill=\"#eef0f2\" stroke=\"#cfd3d8\" stroke-width=\"3\"/>\n      <path d=\"M345 345 Q330 320 355 322\" fill=\"none\" stroke=\"#cfd3d8\" stroke-width=\"2\"/>\n    </g>\n    <!-- 腿到脚踏 -->\n    <g stroke=\"#f39c12\" stroke-width=\"9\" stroke-linecap=\"round\" fill=\"none\">\n      <path d=\"M405 390 Q420 410 430 452\">\n        <animate attributeName=\"d\"\n          values=\"M405 390 Q420 410 430 452; M405 390 Q430 400 430 456; M405 390 Q420 410 430 452\"\n          dur=\"0.9s\" repeatCount=\"indefinite\"/>\n      </path>\n    </g>\n    <g stroke=\"#f39c12\" stroke-width=\"9\" stroke-linecap=\"round\" fill=\"none\">\n      <path d=\"M410 388 Q430 400 430 384\">\n        <animate attributeName=\"d\"\n          values=\"M410 388 Q430 400 430 384; M410 388 Q420 405 430 380; M410 388 Q430 400 430 384\"\n          dur=\"0.9s\" repeatCount=\"indefinite\"/>\n      </path>\n    </g>\n    <!-- 脖子 -->\n    <path d=\"M415 340 Q470 320 470 270 Q470 240 455 225\"\n      fill=\"none\" stroke=\"#fbf7ec\" stroke-width=\"26\" stroke-linecap=\"round\"/>\n    <!-- 头 -->\n    <circle cx=\"455\" cy=\"215\" r=\"34\" fill=\"#fbf7ec\" stroke=\"#d9d2bd\" stroke-width=\"3\"/>\n    <!-- 眼睛 -->\n    <circle cx=\"466\" cy=\"206\" r=\"6\" fill=\"#2c3e50\"/>\n    <circle cx=\"468\" cy=\"204\" r=\"2\" fill=\"#fff\"/>\n    <!-- 大喙 + 喉囊 -->\n    <path d=\"M470 210 Q560 205 600 235 Q560 250 495 245 Q470 235 470 210 Z\"\n      fill=\"#f5b841\" stroke=\"#d98a1e\" stroke-width=\"3\"/>\n    <!-- 喉囊下垂 -->\n    <path d=\"M495 245 Q540 250 595 238 Q585 285 520 275 Q490 265 495 245 Z\"\n      fill=\"#f8c86a\" stroke=\"#d98a1e\" stroke-width=\"3\"/>\n    <!-- 嘴线 -->\n    <line x1=\"472\" y1=\"212\" x2=\"600\" y2=\"235\" stroke=\"#d98a1e\" stroke-width=\"3\"/>\n    <!-- 头顶小羽 -->\n    <path d=\"M448 184 Q442 170 452 168 Q452 180 456 186 Z\" fill=\"#f5f0e1\"/>\n\n    <!-- 翅膀抓车把 -->\n    <path d=\"M400 345 Q470 330 545 315\" fill=\"none\" stroke=\"#eef0f2\" stroke-width=\"16\" stroke-linecap=\"round\"/>\n    <path d=\"M400 345 Q470 330 545 315\" fill=\"none\" stroke=\"#cfd3d8\" stroke-width=\"2\"/>\n  </g>\n</svg>\n</div>\n</body>\n</html>\n"
