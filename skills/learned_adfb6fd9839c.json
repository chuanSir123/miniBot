        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>鹈鹕骑自行车 🚲</title>\n<style>\n  html,body{margin:0;padding:0;height:100%;background:linear-gradient(#bfe6ff 0%,#e8f6ff 60%,#f7e9c9 100%);overflow:hidden;font-family:sans-serif}\n  .wrap{display:flex;align-items:center;justify-content:center;height:100%}\n  svg{width:90vmin;height:90vmin;max-width:900px;max-height:900px}\n  /* 轮子旋转 */\n  .wheel{transform-origin:center;transform-box:fill-box;animation:spin 1.1s linear infinite}\n  @keyframes spin{to{transform:rotate(360deg)}}\n  /* 踏板旋转 */\n  .pedal{transform-origin:center;transform-box:fill-box;animation:spin 1.1s linear infinite}\n  /* 鹈鹕上下轻微颠簸 */\n  .bird{animation:bob 0.55s ease-in-out infinite}\n  @keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}\n  /* 翅膀摆动 */\n  .wing{transform-origin:left center;transform-box:fill-box;animation:flap 0.55s ease-in-out infinite}\n  @keyframes flap{0%,100%{transform:rotate(-8deg)}50%{transform:rotate(10deg)}}\n  /* 尾巴摆动 */\n  .tail{transform-origin:left center;transform-box:fill-box;animation:tail 0.8s ease-in-out infinite}\n  @keyframes tail{0%,100%{transform:rotate(-6deg)}50%{transform:rotate(8deg)}}\n  /* 头部点头 */\n  .head{transform-origin:bottom center;transform-box:fill-box;animation:head 1.1s ease-in-out infinite}\n  @keyframes head{0%,100%{transform:rotate(-3deg)}50%{transform:rotate(4deg)}}\n  /* 云朵飘过 */\n  .cloud1{animation:drift1 14s linear infinite}\n  .cloud2{animation:drift2 20s linear infinite}\n  @keyframes drift1{from{transform:translateX(-120px)}to{transform:translateX(920px)}}\n  @keyframes drift2{from{transform:translateX(920px)}to{transform:translateX(-160px)}}\n  /* 地面滚动线条 */\n  .ground{animation:ground 1.1s linear infinite}\n  @keyframes ground{from{transform:translateX(0)}to{transform:translateX(-80px)}}\n  /* 速度线 */\n  .speed{animation:speed 0.6s linear infinite}\n  @keyframes speed{0%{opacity:0;transform:translateX(0)}30%{opacity:.6}100%{opacity:0;transform:translateX(-60px)}}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n<svg viewBox=\"0 0 800 600\" xmlns=\"http://www.w3.org/2000/svg\">\n  <!-- 太阳 -->\n  <circle cx=\"680\" cy=\"90\" r=\"46\" fill=\"#ffe27a\" opacity=\"0.9\"/>\n\n  <!-- 云朵 -->\n  <g class=\"cloud1\" fill=\"#ffffff\" opacity=\"0.9\">\n    <ellipse cx=\"120\" cy=\"90\" rx=\"46\" ry=\"24\"/>\n    <ellipse cx=\"160\" cy=\"80\" rx=\"34\" ry=\"22\"/>\n    <ellipse cx=\"90\" cy=\"82\" rx=\"28\" ry=\"18\"/>\n  </g>\n  <g class=\"cloud2\" fill=\"#ffffff\" opacity=\"0.8\">\n    <ellipse cx=\"520\" cy=\"150\" rx=\"40\" ry=\"20\"/>\n    <ellipse cx=\"555\" cy=\"142\" rx=\"30\" ry=\"18\"/>\n  </g>\n\n  <!-- 速度线 -->\n  <g stroke=\"#9fd3ff\" stroke-width=\"5\" stroke-linecap=\"round\">\n    <line class=\"speed\" x1=\"180\" y1=\"330\" x2=\"120\" y2=\"330\"/>\n    <line class=\"speed\" x1=\"200\" y1=\"370\" x2=\"140\" y2=\"370\" style=\"animation-delay:.2s\"/>\n    <line class=\"speed\" x1=\"190\" y1=\"410\" x2=\"130\" y2=\"410\" style=\"animation-delay:.4s\"/>\n  </g>\n\n  <!-- 地面滚动线 -->\n  <g class=\"ground\" stroke=\"#c9a86a\" stroke-width=\"4\" stroke-linecap=\"round\">\n    <line x1=\"0\" y1=\"470\" x2=\"70\" y2=\"470\"/>\n    <line x1=\"80\" y1=\"470\" x2=\"150\" y2=\"470\"/>\n    <line x1=\"160\" y1=\"470\" x2=\"230\" y2=\"470\"/>\n    <line x1=\"240\" y1=\"470\" x2=\"310\" y2=\"470\"/>\n    <line x1=\"320\" y1=\"470\" x2=\"390\" y2=\"470\"/>\n    <line x1=\"400\" y1=\"470\" x2=\"470\" y2=\"470\"/>\n    <line x1=\"480\" y1=\"470\" x2=\"550\" y2=\"470\"/>\n    <line x1=\"560\" y1=\"470\" x2=\"630\" y2=\"470\"/>\n    <line x1=\"640\" y1=\"470\" x2=\"710\" y2=\"470\"/>\n    <line x1=\"720\" y1=\"470\" x2=\"790\" y2=\"470\"/>\n  </g>\n\n  <!-- 自行车 -->\n  <g>\n    <!-- 后轮 -->\n    <g class=\"wheel\">\n      <circle cx=\"250\" cy=\"440\" r=\"62\" fill=\"none\" stroke=\"#333\" stroke-width=\"8\"/>\n      <circle cx=\"250\" cy=\"440\" r=\"6\" fill=\"#333\"/>\n      <g stroke=\"#666\" stroke-width=\"3\">\n        <line x1=\"250\" y1=\"380\" x2=\"250\" y2=\"500\"/>\n        <line x1=\"190\" y1=\"440\" x2=\"310\" y2=\"440\"/>\n        <line x1=\"208\" y1=\"398\" x2=\"292\" y2=\"482\"/>\n        <line x1=\"292\" y1=\"398\" x2=\"208\" y2=\"482\"/>\n      </g>\n    </g>\n    <!-- 前轮 -->\n    <g class=\"wheel\">\n      <circle cx=\"560\" cy=\"440\" r=\"62\" fill=\"none\" stroke=\"#333\" stroke-width=\"8\"/>\n      <circle cx=\"560\" cy=\"440\" r=\"6\" fill=\"#333\"/>\n      <g stroke=\"#666\" stroke-width=\"3\">\n        <line x1=\"560\" y1=\"380\" x2=\"560\" y2=\"500\"/>\n        <line x1=\"500\" y1=\"440\" x2=\"620\" y2=\"440\"/>\n        <line x1=\"518\" y1=\"398\" x2=\"602\" y2=\"482\"/>\n        <line x1=\"602\" y1=\"398\" x2=\"518\" y2=\"482\"/>\n      </g>\n    </g>\n\n    <!-- 车架 -->\n    <g stroke=\"#e0453a\" stroke-width=\"9\" fill=\"none\" stroke-linecap=\"round\">\n      <!-- 后轴到踏板 -->\n      <line x1=\"250\" y1=\"440\" x2=\"380\" y2=\"440\"/>\n      <!-- 踏板到座管 -->\n      <line x1=\"380\" y1=\"440\" x2=\"350\" y2=\"330\"/>\n      <!-- 座管到后轴 -->\n      <line x1=\"350\" y1=\"330\" x2=\"250\" y2=\"440\"/>\n      <!-- 踏板到头管 -->\n      <line x1=\"380\" y1=\"440\" x2=\"540\" y2=\"340\"/>\n      <!-- 头管到前叉 -->\n      <line x1=\"540\" y1=\"340\" x2=\"560\" y2=\"440\"/>\n      <!-- 座管到头管 -->\n      <line x1=\"350\" y1=\"330\" x2=\"540\" y2=\"340\"/>\n    </g>\n\n    <!-- 车座 -->\n    <ellipse cx=\"348\" cy=\"322\" rx=\"26\" ry=\"12\" fill=\"#333\"/>\n    <!-- 车把 -->\n    <path d=\"M540 340 q 22 -26 44 -18\" fill=\"none\" stroke=\"#333\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n    <circle cx=\"586\" cy=\"322\" r=\"7\" fill=\"#333\"/>\n\n    <!-- 曲柄 + 踏板 -->\n    <g class=\"pedal\">\n      <circle cx=\"380\" cy=\"440\" r=\"10\" fill=\"#555\"/>\n      <line x1=\"380\" y1=\"440\" x2=\"418\" y2=\"418\" stroke=\"#555\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n      <line x1