        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>鹈鹕骑自行车 · SVG 动画</title>\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: #0b1220;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 100vh;\n    font-family: \"Segoe UI\", \"Microsoft YaHei\", sans-serif;\n  }\n  .stage {\n    width: 100%;\n    max-width: 1280px;\n    box-shadow: 0 20px 60px rgba(0,0,0,.5);\n    border-radius: 14px;\n    overflow: hidden;\n  }\n  svg { display: block; width: 100%; height: auto; }\n\n  /* 轮子辐条旋转：绕自己圆心 */\n  .wheel-spin {\n    transform-box: fill-box;\n    transform-origin: center;\n    animation: spin 1.2s linear infinite;\n  }\n  @keyframes spin {\n    from { transform: rotate(0deg); }\n    to   { transform: rotate(360deg); }\n  }\n\n  /* 路面虚线滚动 */\n  .road-dash {\n    animation: roadmove 1.2s linear infinite;\n  }\n  @keyframes roadmove {\n    from { transform: translateX(0); }\n    to   { transform: translateX(-60px); }\n  }\n\n  /* 云漂移 */\n  .cloud-a { animation: cloudA 9s ease-in-out infinite alternate; }\n  .cloud-b { animation: cloudB 12s ease-in-out infinite alternate; }\n  @keyframes cloudA { from { transform: translateX(0); } to { transform: translateX(40px); } }\n  @keyframes cloudB { from { transform: translateX(0); } to { transform: translateX(-50px); } }\n\n  /* 风吹线条 */\n  .wind { animation: wind 1.5s linear infinite; }\n  .wind-2 { animation-delay: .5s; }\n  .wind-3 { animation-delay: 1s; }\n  @keyframes wind {\n    0%   { opacity: 0; transform: translateX(30px); }\n    30%  { opacity: .8; }\n    100% { opacity: 0; transform: translateX(-120px); }\n  }\n\n  /* 头 / 尾 轻摆 */\n  .head-bob {\n    transform-box: fill-box;\n    transform-origin: 600px 395px;\n    animation: headbob 2.4s ease-in-out infinite alternate;\n  }\n  @keyframes headbob {\n    from { transform: rotate(-2.5deg); }\n    to   { transform: rotate(2.5deg); }\n  }\n  .tail-bob {\n    transform-box: fill-box;\n    transform-origin: 560px 470px;\n    animation: tailbob 2.4s ease-in-out infinite alternate;\n  }\n  @keyframes tailbob {\n    from { transform: rotate(-3deg); }\n    to   { transform: rotate(3deg); }\n  }\n</style>\n</head>\n<body>\n<div class=\"stage\">\n<svg viewBox=\"0 0 1280 800\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"一只鹈鹕骑着一辆红色自行车\">\n  <defs>\n    <linearGradient id=\"sky\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n      <stop offset=\"0%\"  stop-color=\"#8fd3ff\"/>\n      <stop offset=\"55%\" stop-color=\"#bfe6ff\"/>\n      <stop offset=\"100%\" stop-color=\"#e8f6ff\"/>\n    </linearGradient>\n    <linearGradient id=\"ground\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n      <stop offset=\"0%\"  stop-color=\"#7cc46b\"/>\n      <stop offset=\"100%\" stop-color=\"#5aa64e\"/>\n    </linearGradient>\n    <radialGradient id=\"sun\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n      <stop offset=\"0%\"  stop-color=\"#fff4b0\"/>\n      <stop offset=\"60%\" stop-color=\"#ffd85e\"/>\n      <stop offset=\"100%\" stop-color=\"#ffc837\" stop-opacity=\"0\"/>\n    </radialGradient>\n  </defs>\n\n  <!-- 天空 -->\n  <rect x=\"0\" y=\"0\" width=\"1280\" height=\"800\" fill=\"url(#sky)\"/>\n\n  <!-- 太阳 -->\n  <circle cx=\"1120\" cy=\"110\" r=\"120\" fill=\"url(#sun)\"/>\n  <circle cx=\"1120\" cy=\"110\" r=\"55\" fill=\"#ffd85e\"/>\n\n  <!-- 云 -->\n  <g class=\"cloud-a\" fill=\"#ffffff\" opacity=\"0.92\">\n    <ellipse cx=\"220\" cy=\"140\" rx=\"60\" ry=\"28\"/>\n    <ellipse cx=\"270\" cy=\"125\" rx=\"45\" ry=\"26\"/>\n    <ellipse cx=\"175\" cy=\"128\" rx=\"38\" ry=\"22\"/>\n  </g>\n  <g class=\"cloud-b\" fill=\"#ffffff\" opacity=\"0.85\">\n    <ellipse cx=\"720\" cy=\"95\" rx=\"55\" ry=\"24\"/>\n    <ellipse cx=\"765\" cy=\"82\" rx=\"40\" ry=\"22\"/>\n    <ellipse cx=\"680\" cy=\"86\" rx=\"34\" ry=\"18\"/>\n  </g>\n\n  <!-- 风吹线条 -->\n  <g stroke=\"#ffffff\" stroke-width=\"6\" stroke-linecap=\"round\" opacity=\"0.7\">\n    <line class=\"wind\"        x1=\"360\" y1=\"300\" x2=\"470\" y2=\"300\"/>\n    <line class=\"wind wind-2\" x1=\"330\" y1=\"360\" x2=\"440\" y2=\"360\"/>\n    <line class=\"wind wind-3\" x1=\"380\" y1=\"420\" x2=\"470\" y2=\"420\"/>\n  </g>\n\n  <!-- 地面 -->\n  <rect x=\"0\" y=\"640\" width=\"1280\" height=\"160\" fill=\"url(#ground)\"/>\n  <!-- 路面 -->\n  <rect x=\"0\" y=\"640\" width=\"1280\" height=\"34\" fill=\"#3a3f4a\"/>\n  <g class=\"road-dash\">\n    <g fill=\"#f4d35e\">\n      <!-- 重复虚线段，向左滚动 -->\n      <rect x=\"-60\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"0\"   y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"60\"  y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"120\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"180\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"240\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"300\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"360\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"420\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"480\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"540\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"600\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"660\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"720\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"780\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"840\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"900\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"960\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"1020\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"1080\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"1140\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"1200\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"1260\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n      <rect x=\"1320\" y=\"653\" width=\"34\" height=\"8\" rx=\"4\"/>\n    </g>\n  </g>\n\n  <!-- ===== 自行车 ===== -->\n  <!-- 后轮 -->\n  <g>\n    <circle cx=\"380\" cy=\"600\" r=\"95\" fill=\"none\" stroke=\"#2b2f38\" stroke-width=\"14\"/>\n    <circle cx=\"380\" cy=\"600\" r=\"95\" fill=\"none\" stroke=\"#454b57\" stroke-width=\"6\"/>\n    <g class=\"wheel-spin\" id=\"spokes-back\">\n      <g stroke=\"#9aa3b2\" stroke-width=\"4\" stroke-linecap=\"round\">\n        <line x1=\"380\" y1=\"505\" x2=\"380\" y2=\"695\"/>\n        <line x1=\"285\" y1=\"600\" x2=\"475\" y2=\"600\"/>\n        <line x1=\"313\" y1=\"533\" x2=\"447\" y2=\"667\"/>\n        <line x1=\"447\" y1=\"533\" x2=\"313\" y2=\"667\"/>\n        <line x1=\"350\" y1=\"512\" x2=\"410\" y2=\"688\"/>\n        <line x1=\"410\" y1=\"512\" x2=\"350\" y2=\"688\"/>\n        <line x1=\"292\" y1=\"570\" x2=\"468\" y2=\"630\"/>\n        <line x1=\"468\" y1=\"570\" x2=\"292\" y2=\"630\"/>\n      </g>\n    </g>\n    <circle cx=\"380\" cy=\"600\" r=\"12\" fill=\"#2b2f38\"/>\n  </g>\n\n  <!-- 前轮 -->\n  <g>\n    <circle cx=\"760\" cy=\"600\" r=\"95\" fill=\"none\" stroke=\"#2b2f38\" stroke-width=\"14\"/>\n    <circle cx=\"760\" cy=\"600\" r=\"95\" fill=\"none\" stroke=\"#454b57\" stroke-width=\"6\"/>\n    <g class=\"wheel-spin\" id=\"spokes-front\">\n      <g stroke=\"#9aa3b2\" stroke-width=\"4\" stroke-linecap=\"round\">\n        <line x1=\"760\" y1=\"505\" x2=\"760\" y2=\"695\"/>\n        <line x1=\"665\" y1=\"600\" x2=\"855\" y2=\"600\"/>\n        <line x1=\"693\" y1=\"533\" x2=\"827\" y2=\"667\"/>\n        <line x1=\"827\" y1=\"533\" x2=\"693\" y2=\"667\"/>\n        <line x1=\"730\" y1=\"512\" x2=\"790\" y2=\"688\"/>\n        <line x1=\"790\" y1=\"512\" x2=\"730\" y2=\"688\"/>\n        <line x1=\"672\" y1=\"570\" x2=\"848\" y2=\"630\"/>\n        <line x1=\"848\" y1=\"570\" x2=\"672\" y2=\"630\"/>\n      </g>\n    </g>\n    <circle cx=\"760\" cy=\"600\" r=\"12\" fill=\"#2b2f38\"/>\n  </g>\n\n  <!-- 车架（红色） -->\n  <g stroke=\"#d63b2f\" stroke-width=\"12\" stroke-linecap=\"round\" fill=\"none\">\n    <!-- 后叉 -->\n    <line x1=\"380\" y1=\"600\" x2=\"560\" y2=\"560\"/>\n    <line x1=\"380\" y1=\"600\" x2=\"500\" y2=\"430\"/>\n    <!-- 座管 -->\n    <line x1=\"560\" y1=\"560\" x2=\"505\" y2=\"415\"/>\n    <!-- 下管 -->\n    <line x1=\"560\" y1=\"560\" x2=\"700\" y2=\"420\"/>\n    <!-- 上管 -->\n    <line x1=\"505\" y1=\"430\" x2=\"700\" y2=\"420\"/>\n    <!-- 前叉 -->\n    <line x1=\"700\" y1=\"420\" x2=\"760\" y2=\"600\"/>\n  </g>\n\n  <!-- 牙盘 / 五通 -->\n  <circle cx=\"560\" cy=\"560\" r=\"26\" fill=\"#2b2f38\"/>\n  <circle cx=\"560\" cy=\"560\" r=\"26\" fill=\"none\" stroke=\"#454b57\" stroke-width=\"4\"/>\n  <circle cx=\"560\" cy=\"560\" r=\"7\" fill=\"#9aa3b2\"/>\n\n  <!-- 曲柄 + 踏板（JS 驱动） -->\n  <g id=\"crank-group\">\n    <line id=\"crank1\" x1=\"560\" y1=\"560\" x2=\"615\" y2=\"560\" stroke=\"#2b2f38\" stroke-width=\"9\" stroke-linecap=\"round\"/>\n    <line id=\"crank2\" x1=\"560\" y1=\"560\" x2=\"505\" y2=\"560\" stroke=\"#2b2f38\" stroke-width=\"9\" stroke-linecap=\"round\"/>\n    <rect id=\"pedal1\" x=\"598\" y=\"554\" width=\"34\" height=\"12\" rx=\"4\" fill=\"#1c1f26\"/>\n    <rect id=\"pedal2\" x=\"488\" y=\"554\" width=\"34\" height=\"12\" rx=\"4\" fill=\"#1c1f26\"/>\n  </g>\n\n  <!-- 车座 -->\n  <path d=\"M470 415 q35 -22 70 0 q-35 12 -70 0 Z\" fill=\"#1c1f26\"/>\n  <rect x=\"498\" y=\"415\" width=\"14\" height=\"14\" fill=\"#1c1f26\"/>\n\n  <!-- 车把 -->\n  <path d=\"M700 420 q40 -50 40 -50\" stroke=\"#1c1f26\" stroke-width=\"12\" fill=\"none\" stroke-linecap=\"round\"/>\n  <path d=\"M740 370 q18 0 22 16\" stroke=\"#1c1f26\" stroke-width=\"12\" fill=\"none\" stroke-linecap=\"round\"/>\n\n  <!-- ===== 鹈鹕 ===== -->\n  <!-- 尾巴（轻摆） -->\n  <g class=\"tail-bob\">\n    <path d=\"M560 470 q-70 -10 -120 30 q60 20 120 10 Z\" fill=\"#f4f6fb\"/>\n    <path d=\"M560 470 q-55 -6 -95 22 q45 14 95 6 Z\" fill=\"#dde3ee\"/>\n  </g>\n\n  <!-- 身体（坐姿，底边压住座面） -->\n  <path d=\"M520 470\n           C 480 430, 490 380, 540 360\n           C 560 352, 590 350, 610 356\n           C 650 366, 660 410, 640 450\n           C 630 468, 600 470, 560 470 Z\" fill=\"#f4f6fb\" stroke=\"#cfd6e4\" stroke-width=\"3\"/>\n  <!-- 胸腹羽毛 -->\n  <path d=\"M540 455 C 520 430, 525 400, 555 385 C 580 375, 605 385, 615 410 C 622 432, 605 452, 580 456 Z\" fill=\"#ffffff\"/>\n\n  <!-- 脖子 + 头 + 喙 + 喉囊（轻摆） -->\n  <g class=\"head-bob\">\n    <!-- 长脖子 -->\n    <path d=\"M600 395\n             C 610 360, 630 330, 648 305\n             C 655 295, 662 288, 665 285\n             L 685 300\n             C 678 312, 668 330, 660 355\n             C 655 375, 652 390, 650 400 Z\"\n          fill=\"#f4f6fb\" stroke=\"#cfd6e4\" stroke-width=\"3\"/>\n    <!-- 头 -->\n    <circle cx=\"665\" cy=\"278\" r=\"42\" fill=\"#f4f6fb\" stroke=\"#cfd6e4\" stroke-width=\"3\"/>\n    <!-- 头顶小羽 -->\n    <path d=\"M650 240 q10 -18 24 -6 q-8 14 -14 18 q-8 -6 -10 -12 Z\" fill=\"#dde3ee\"/>\n    <!-- 眼睛 -->\n    <circle cx=\"676\" cy=\"272\" r=\"7\" fill=\"#1c1f26\"/>\n    <circle cx=\"678\" cy=\"270\" r=\"2.4\" fill=\"#ffffff\"/>\n    <!-- 脸颊 -->\n    <ellipse cx=\"690\" cy=\"292\" rx=\"10\" ry=\"7\" fill=\"#ffd0d6\" opacity=\"0.6\"/>\n\n    <!-- 大喙（鹈鹕标志） -->\n    <path d=\"M700 270\n             q60 6 96 30\n             q-40 26 -96 18\n             q-14 -24 0 -48 Z\"\n          fill=\"#f6a623\" stroke=\"#d9881f\" stroke-width=\"3\"/>\n    <!-- 喙上缝 -->\n    <path d=\"M704 286 q48 10 84 26\" stroke=\"#d9881f\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/>\n    <!-- 喉囊（下垂的大口袋） -->\n    <path d=\"M704 292\n             q52 10 88 28\n             q18 40 -22 66\n             q-40 24 -66 -8\n             q-6 -40 0 -86 Z\"\n          fill=\"#f6a623\" stroke=\"#d9881f\" stroke-width=\"3\"/>\n    <path d=\"M712 300 q44 12 74 30\" stroke=\"#d9881f\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\"/>\n  </g>\n\n  <!-- 翅膀手臂（从肩前伸，手握车把弯头） -->\n  <path d=\"M600 395\n           C 640 380, 690 368, 735 372\n           C 748 373, 752 380, 748 388\n           C 700 392, 650 404, 612 412\n           C 598 414, 596 402, 600 395 Z\"\n        fill=\"#eef1f8\" stroke=\"#cfd6e4\" stroke-width=\"3\"/>\n  <!-- 手（握把） -->\n  <circle cx=\"740\" cy=\"370\" r=\"11\" fill=\"#f4f6fb\" stroke=\"#cfd6e4\" stroke-width=\"3\"/>\n\n  <!-- ===== 腿（JS 驱动 IK） ===== -->\n  <g id=\"leg-far\" opacity=\"0.55\">\n    <line id=\"thigh-far\"  x1=\"545\" y1=\"455\" x2=\"560\" y2=\"540\" stroke=\"#c9d0de\" stroke-width=\"16\" stroke-linecap=\"round\"/>\n    <line id=\"shin-far\"   x1=\"560\" y1=\"540\" x2=\"560\" y2=\"550\" stroke=\"#c9d0de\" stroke-width=\"14\" stroke-linecap=\"round\"/>\n    <ellipse id=\"foot-far\" cx=\"560\" cy=\"550\" rx=\"16\" ry=\"9\" fill=\"#f6a623\"/>\n  </g>\n  <g id=\"leg-near\">\n    <line id=\"thigh-near\" x1=\"545\" y1=\"455\" x2=\"560\" y2=\"540\" stroke=\"#f4f6fb\" stroke-width=\"18\" stroke-linecap=\"round\"/>\n    <line id=\"shin-near\"  x1=\"560\" y1=\"540\" x2=\"560\" y2=\"550\" stroke=\"#f4f6fb\" stroke-width=\"15\" stroke-linecap=\"round\"/>\n    <ellipse id=\"foot-near\" cx=\"560\" cy=\"550\" rx=\"18\" ry=\"10\" fill=\"#f6a623\" stroke=\"#d9881f\" stroke-width=\"2\"/>\n  </g>\n\n  <!-- 标题 -->\n  <text x=\"40\" y=\"60\" font-size=\"30\" font-weight=\"700\" fill=\"#2b3a55\" opacity=\"0.85\">🦩 鹈鹕骑自行车</text>\n</svg>\n</div>\n\n<script>\n(function () {\n  \"use strict\";\n\n  // ---- 固定锚点 ----\n  var HIP   = { x: 545, y: 455 };  // 胯部\n  var BB    = { x: 560, y: 560 };  // 五通中心\n  var CRANK = 55;                  // 曲柄长\n  var THIGH = 95;                  // 大腿长\n  var SHIN  = 95;                  // 小腿长\n  var FOOT_LIFT = 10;              // 脚踝在踏板上方 10px\n\n  var PERIOD = 1200;               // 与轮子同步 1.2s\n  var TAU = Math.PI * 2;\n\n  // ---- 元素 ----\n  var crank1 = document.getElementById(\"crank1\");\n  var crank2 = document.getElementById(\"crank2\");\n  var pedal1 = document.getElementById(\"pedal1\");\n  var pedal2 = document.getElementById(\"pedal2\");\n  var thighNear = document.getElementById(\"thigh-near\");\n  var shinNear  = document.getElementById(\"shin-near\");\n  var footNear  = document.getElementById(\"foot-near\");\n  var thighFar  = document.getElementById(\"thigh-far\");\n  var shinFar   = document.getElementById(\"shin-far\");\n  var footFar   = document.getElementById(\"foot-far\");\n\n  // 两圆交点求膝盖：hip 与 ankle 已知，两腿长 thigh/shin\n  function solveKnee(hip, ankle, L1, L2) {\n    var dx = ankle.x - hip.x;\n    var dy = ankle.y - hip.y;\n    var d = Math.sqrt(dx * dx + dy * dy);\n\n    // 夹紧，防止两圆不相交\n    var maxD = L1 + L2 - 0.001;\n    if (d > maxD) {\n      var k = maxD / d;\n      ankle = { x: hip.x + dx * k, y: hip.y + dy * k };\n      d = maxD;\n    }\n    var minD = Math.abs(L1 - L2) + 0.001;\n    if (d < minD) d = minD;\n\n    var a = (L1 * L1 - L2 * L2) / (2 * d);\n    var h = Math.sqrt(Math.max(0, L1 * L1 - a * a));\n\n    var mx = hip.x + a * dx / d;\n    var my = hip.y + a * dy / d;\n\n    // 取使膝盖向前（偏 +x / 偏上）的解：垂直方向 (dy, -dx)\n    var ox = -dy / d * h;\n    var oy =  dx / d * h;\n    // 选让膝盖 x 更大（向前）的那个交点\n    var k1 = { x: mx + ox, y: my + oy };\n    var k2 = { x: mx - ox, y: my - oy };\n    return (k1.x > k2.x) ? k1 : k2;\n  }\n\n  function setLine(el, x1, y1, x2, y2) {\n    el.setAttribute(\"x1\", x1);\n    el.setAttribute(\"y1\", y1);\n    el.setAttribute(\"x2\", x2);\n    el.setAttribute(\"y2\", y2);\n  }\n  function setFoot(el, x, y) {\n    el.setAttribute(\"cx\", x);\n    el.setAttribute(\"cy\", y);\n  }\n  function setPedal(el, x, y) {\n    // 踏板水平居中在脚踝位置\n    el.setAttribute(\"x\", x - 17);\n    el.setAttribute(\"y\", y - 6);\n  }\n\n  function leg(ankle, thighEl, shinEl, footEl) {\n    var knee = solveKnee(HIP, ankle, THIGH, SHIN);\n    setLine(thighEl, HIP.x, HIP.y, knee.x, knee.y);\n    setLine(shinEl, knee.x, knee.y, ankle.x, ankle.y);\n    setFoot(footEl, ankle.x, ankle.y);\n  }\n\n  var start = null;\n  function frame(ts) {\n    if (start === null) start = ts;\n    var t = ts - start;\n    var theta = (t / PERIOD) * TAU; // 匀速\n\n    // 踏板 1（近侧，θ）\n    var p1x = BB.x + CRANK * Math.cos(theta);\n    var p1y = BB.y + CRANK * Math.sin(theta);\n    // 踏板 2（远侧，θ+π）\n    var p2x = BB.x + CRANK * Math.cos(theta + Math.PI);\n    var p2y = BB.y + CRANK * Math.sin(theta + Math.PI);\n\n    // 曲柄\n    setLine(crank1, BB.x, BB.y, p1x, p1y);\n    setLine(crank2, BB.x, BB.y, p2x, p2y);\n    // 踏板\n    setPedal(pedal1, p1x, p1y);\n    setPedal(pedal2, p2x, p2y);\n\n    // 脚踝 = 踏板位置上方 10px（脚踩在板上，从踏板倒推）\n    var a1 = { x: p1x, y: p1y - FOOT_LIFT };\n    var a2 = { x: p2x, y: p2y - FOOT_LIFT };\n\n    // 远侧腿先画（在身体后面，半透明）\n    leg(a2, thighFar, shinFar, footFar);\n    // 近侧腿\n    leg(a1, thighNear, shinNear, footNear);\n\n    requestAnimationFrame(frame);\n  }\n  requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>\n"
      }
