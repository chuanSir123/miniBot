        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<title>鹈鹕骑自行车 🦩🚲</title>\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    background: linear-gradient(#a8e0ff 0%, #d6f0ff 60%, #b8e6c8 60%, #8fd6a8 100%);\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: \"Segoe UI\", \"Microsoft YaHei\", sans-serif;\n  }\n  .stage {\n    width: 900px;\n    height: 520px;\n    background: transparent;\n  }\n  .title {\n    position: absolute;\n    top: 8px;\n    left: 16px;\n    font-size: 22px;\n    color: #2b5f8a;\n    font-weight: bold;\n    text-shadow: 0 1px 0 #fff;\n  }\n  /* 地面滚动：让背景纹理循环移动，营造骑行感 */\n  @keyframes groundScroll {\n    from { transform: translateX(0); }\n    to   { transform: translateX(-200px); }\n  }\n  .ground-strip {\n    animation: groundScroll 1.2s linear infinite;\n  }\n  /* 云飘动 */\n  @keyframes cloudMove {\n    from { transform: translateX(0); }\n    to   { transform: translateX(-950px); }\n  }\n  .cloud { animation: cloudMove 14s linear infinite; }\n  .cloud.c2 { animation-duration: 20s; animation-delay: -6s; }\n  .cloud.c3 { animation-duration: 17s; animation-delay: -11s; }\n\n  /* 车轮旋转 */\n  @keyframes wheelSpin {\n    from { transform: rotate(0deg); }\n    to   { transform: rotate(360deg); }\n  }\n  .wheel {\n    transform-box: fill-box;\n    transform-origin: center;\n    animation: wheelSpin 1.2s linear infinite;\n  }\n\n  /* 鹈鹕身体上下轻微起伏（骑行颠簸感） */\n  @keyframes bodyBob {\n    0%   { transform: translateY(0); }\n    50%  { transform: translateY(-4px); }\n    100% { transform: translateY(0); }\n  }\n  .pelican-body {\n    animation: bodyBob 0.6s ease-in-out infinite;\n  }\n\n  /* 鹈鹕腿部踩踏板：两条腿交替 */\n  @keyframes legFront {\n    0%   { transform: rotate(0deg); }\n    50%  { transform: rotate(28deg); }\n    100% { transform: rotate(0deg); }\n  }\n  @keyframes legBack {\n    0%   { transform: rotate(28deg); }\n    50%  { transform: rotate(0deg); }\n    100% { transform: rotate(28deg); }\n  }\n  .leg-front {\n    transform-box: fill-box;\n    transform-origin: 50% 10%;\n    animation: legFront 1.2s ease-in-out infinite;\n  }\n  .leg-back {\n    transform-box: fill-box;\n    transform-origin: 50% 10%;\n    animation: legBack 1.2s ease-in-out infinite;\n  }\n\n  /* 尾巴摇摆 */\n  @keyframes tailWag {\n    0%,100% { transform: rotate(-8deg); }\n    50%     { transform: rotate(10deg); }\n  }\n  .tail {\n    transform-box: fill-box;\n    transform-origin: 100% 50%;\n    animation: tailWag 1.2s ease-in-out infinite;\n  }\n\n  /* 翅膀拍动 */\n  @keyframes wingFlap {\n    0%,100% { transform: rotate(-6deg); }\n    50%     { transform: rotate(14deg); }\n  }\n  .wing {\n    transform-box: fill-box;\n    transform-origin: 80% 30%;\n    animation: wingFlap 0.6s ease-in-out infinite;\n  }\n\n  /* 速度线 */\n  @keyframes speedLine {\n    0%   { opacity: 0; transform: translateX(0); }\n    20%  { opacity: 0.9; }\n    100% { opacity: 0; transform: translateX(-120px); }\n  }\n  .speed {\n    animation: speedLine 1.2s linear infinite;\n  }\n  .speed.s2 { animation-delay: 0.4s; }\n  .speed.s3 { animation-delay: 0.8s; }\n</style>\n</head>\n<body>\n<div class=\"stage\">\n  <div class=\"title\">🐦 鹈鹕骑车中 🚲</div>\n  <svg viewBox=\"0 0 900 520\" width=\"900\" height=\"520\" xmlns=\"http://www.w3.org/2000/svg\">\n    <!-- 天空背景 -->\n    <rect x=\"0\" y=\"0\" width=\"900\" height=\"320\" fill=\"url(#sky)\"/>\n    <defs>\n      <linearGradient id=\"sky\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#a8e0ff\"/>\n        <stop offset=\"100%\" stop-color=\"#e6f6ff\"/>\n      </linearGradient>\n      <linearGradient id=\"grass\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n        <stop offset=\"0%\" stop-color=\"#8fd6a8\"/>\n        <stop offset=\"100%\" stop-color=\"#5cb87f\"/>\n      </linearGradient>\n      <radialGradient id=\"sun\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n        <stop offset=\"0%\" stop-color=\"#fff6c8\"/>\n        <stop offset=\"100%\" stop-color=\"#ffd966\"/>\n      </radialGradient>\n    </defs>\n\n    <!-- 太阳 -->\n    <circle cx=\"800\" cy=\"70\" r=\"42\" fill=\"url(#sun)\"/>\n\n    <!-- 云（循环飘动） -->\n    <g class=\"cloud\">\n      <g fill=\"#ffffff\" opacity=\"0.95\">\n        <ellipse cx=\"200\" cy=\"80\" rx=\"46\" ry=\"18\"/>\n        <ellipse cx=\"230\" cy=\"70\" rx=\"34\" ry=\"16\"/>\n        <ellipse cx=\"170\" cy=\"72\" rx=\"30\" ry=\"14\"/>\n      </g>\n    </g>\n    <g class=\"cloud c2\">\n      <g fill=\"#ffffff\" opacity=\"0.9\">\n        <ellipse cx=\"500\" cy=\"130\" rx=\"52\" ry=\"20\"/>\n        <ellipse cx=\"535\" cy=\"118\" rx=\"36\" ry=\"16\"/>\n        <ellipse cx=\"465\" cy=\"120\" rx=\"32\" ry=\"14\"/>\n      </g>\n    </g>\n    <g class=\"cloud c3\">\n      <g fill=\"#ffffff\" opacity=\"0.85\">\n        <ellipse cx=\"760\" cy=\"180\" rx=\"40\" ry=\"16\"/>\n        <ellipse cx=\"788\" cy=\"172\" rx=\"28\" ry=\"12\"/>\n      </g>\n    </g>\n\n    <!-- 草地 -->\n    <rect x=\"0\" y=\"320\" width=\"900\" height=\"200\" fill=\"url(#grass)\"/>\n\n    <!-- 地面纹理（循环滚动） -->\n    <g class=\"ground-strip\">\n      <g stroke=\"#3f8f5c\" stroke-width=\"3\" stroke-linecap=\"round\" opacity=\"0.7\">\n        <line x1=\"0\"   y1=\"380\" x2=\"40\"  y2=\"380\"/>\n        <line x1=\"80\"  y1=\"410\" x2=\"140\" y2=\"410\"/>\n        <line x1=\"200\" y1=\"370\" x2=\"250\" y2=\"370\"/>\n        <line x1=\"300\" y1=\"430\" x2=\"360\" y2=\"430\"/>\n        <line x1=\"420\" y1=\"390\" x2=\"470\" y2=\"390\"/>\n        <line x1=\"520\" y1=\"420\" x2=\"580\" y2=\"420\"/>\n        <line x1=\"640\" y1=\"380\" x2=\"700\" y2=\"380\"/>\n        <line x1=\"760\" y1=\"410\" x2=\"820\" y2=\"410\"/>\n        <line x1=\"860\" y1=\"390\" x2=\"920\" y2=\"390\"/>\n        <!-- 复制一份用于无缝循环（偏移200） -->\n        <line x1=\"200\" y1=\"380\" x2=\"240\" y2=\"380\"/>\n        <line x1=\"280\" y1=\"410\" x2=\"340\" y2=\"410\"/>\n        <line x1=\"400\" y1=\"370\" x2=\"450\" y2=\"370\"/>\n        <line x1=\"500\" y1=\"430\" x2=\"560\" y2=\"430\"/>\n        <line x1=\"620\" y1=\"390\" x2=\"670\" y2=\"390\"/>\n        <line x1=\"720\" y1=\"420\" x2=\"780\" y2=\"420\"/>\n        <line x1=\"840\" y1=\"380\" x2=\"900\" y2=\"380\"/>\n        <line x1=\"960\" y1=\"410\" x2=\"1020\" y2=\"410\"/>\n      </g>\n      <!-- 小花点缀 -->\n      <g>\n        <circle cx=\"60\"  cy=\"450\" r=\"5\" fill=\"#ff8fb1\"/>\n        <circle cx=\"180\" cy=\"470\" r=\"4\" fill=\"#ffd166\"/>\n        <circle cx=\"340\" cy=\"455\" r=\"5\" fill=\"#ff8fb1\"/>\n        <circle cx=\"520\" cy=\"475\" r=\"4\" fill=\"#c896ff\"/>\n        <circle cx=\"680\" cy=\"450\" r=\"5\" fill=\"#ffd166\"/>\n        <circle cx=\"820\" cy=\"470\" r=\"4\" fill=\"#ff8fb1\"/>\n        <!-- 复制一份 -->\n        <circle cx=\"260\" cy=\"450\" r=\"5\" fill=\"#ff8fb1\"/>\n        <circle cx=\"380\" cy=\"470\" r=\"4\" fill=\"#ffd166\"/>\n        <circle cx=\"540\" cy=\"455\" r=\"5\" fill=\"#c896ff\"/>\n        <circle cx=\"720\" cy=\"475\" r=\"4\" fill=\"#ff8fb1\"/>\n        <circle cx=\"880\" cy=\"450\" r=\"5\" fill=\"#ffd166\"/>\n      </g>\n    </g>\n\n    <!-- 速度线 -->\n    <g stroke=\"#5aa8d8\" stroke-width=\"4\" stroke-linecap=\"round\">\n      <line class=\"speed\"    x1=\"250\" y1=\"250\" x2=\"330\" y2=\"250\"/>\n      <line class=\"speed s2\" x1=\"230\" y1=\"285\" x2=\"310\" y2=\"285\"/>\n      <line class=\"speed s3\" x1=\"260\" y1=\"320\" x2=\"340\" y2=\"320\"/>\n    </g>\n\n    <!-- ============ 自行车 + 鹈鹕 整体（水平位置固定，靠背景滚动产生运动感） ============ -->\n    <g transform=\"translate(430, 180)\">\n\n      <!-- 自行车阴影 -->\n      <ellipse cx=\"120\" cy=\"245\" rx=\"180\" ry=\"14\" fill=\"#000\" opacity=\"0.15\"/>\n\n      <!-- 自行车车架 -->\n      <g stroke=\"#d63031\" stroke-width=\"9\" stroke-linecap=\"round\" fill=\"none\">\n        <!-- 后轮中心 (40,200) 前轮中心 (220,200) -->\n        <!-- 后轮轴到中轴(130,180) -->\n        <line x1=\"40\"  y1=\"200\" x2=\"130\" y2=\"180\"/>\n        <!-- 中轴到前轮轴 -->\n        <line x1=\"130\" y1=\"180\" x2=\"220\" y2=\"200\"/>\n        <!-- 后轮轴到座管顶(110,110) -->\n        <line x1=\"40\"  y1=\"200\" x2=\"110\" y2=\"110\"/>\n        <!-- 座管顶到车把(200,90) -->\n        <line x1=\"110\" y1=\"110\" x2=\"200\" y2=\"90\"/>\n        <!-- 中轴到车把 -->\n        <line x1=\"130\" y1=\"180\" x2=\"200\" y2=\"90\"/>\n      </g>\n\n      <!-- 车座 -->\n      <rect x=\"92\" y=\"98\" width=\"42\" height=\"14\" rx=\"6\" fill=\"#2d3436\"/>\n      <!-- 车把 -->\n      <path d=\"M 200 90 q 18 -6 26 8\" stroke=\"#2d3436\" stroke-width=\"8\" fill=\"none\" stroke-linecap=\"round\"/>\n      <!-- 车铃 -->\n      <circle cx=\"228\" cy=\"98\" r=\"6\" fill=\"#f1c40f\"/>\n\n      <!-- 后轮 -->\n      <g class=\"wheel\">\n        <circle cx=\"40\" cy=\"200\" r=\"48\" fill=\"none\" stroke=\"#2d3436\" stroke-width=\"7\"/>\n        <circle cx=\"40\" cy=\"200\" r=\"42\" fill=\"none\" stroke=\"#555\" stroke-width=\"2\" stroke-dasharray=\"4 6\"/>\n        <g stroke=\"#999\" stroke-width=\"2\">\n          <line x1=\"40\" y1=\"158\" x2=\"40\" y2=\"242\"/>\n          <line x1=\"-2\"  y1=\"200\" x2=\"82\" y2=\"200\"/>\n          <line x1=\"10\"  y1=\"170\" x2=\"70\" y2=\"230\"/>\n          <line x1=\"10\"  y1=\"230\" x2=\"70\" y2=\"170\"/>\n        </g>\n        <circle cx=\"40\" cy=\"200\" r=\"7\" fill=\"#2d3436\"/>\n      </g>\n\n      <!-- 前轮 -->\n      <g class=\"wheel\">\n        <circle cx=\"220\" cy=\"200\" r=\"48\" fill=\"none\" stroke=\"#2d3436\" stroke-width=\"7\"/>\n        <circle cx=\"220\" cy=\"200\" r=\"42\" fill=\"none\" stroke=\"#555\" stroke-width=\"2\" stroke-dasharray=\"4 6\"/>\n        <g stroke=\"#999\" stroke-width=\"2\">\n          <line x1=\"220\" y1=\"158\" x2=\"220\" y2=\"242\"/>\n          <line x1=\"178\" y1=\"200\" x2=\"262\" y2=\"200\"/>\n          <line x1=\"190\" y1=\"170\" x2=\"250\" y2=\"230\"/>\n          <line x1=\"190\" y1=\"230\" x2=\"250\" y2=\"170\"/>\n        </g>\n        <circle cx=\"220\" cy=\"200\" r=\"7\" fill=\"#2d3436\"/>\n      </g>\n\n      <!-- 踏板/牙盘 -->\n      <g>\n        <circle cx=\"130\" cy=\"180\" r=\"16\" fill=\"#636e72\"/>\n        <circle cx=\"130\" cy=\"180\" r=\"6\" fill=\"#2d3436\"/>\n      </g>\n\n      <!-- ============ 鹈鹕 ============ -->\n      <!-- 尾巴（在身体后面） -->\n      <g class=\"tail\">\n        <path d=\"M 60 120 q -40 -10 -55 15 q 20 5 55 -5 z\" fill=\"#f5f0e1\" stroke=\"#d8cfae\" stroke-width=\"2\"/>\n      </g>\n\n      <!-- 后腿（远侧，先画在身体下面） -->\n      <g class=\"leg-back\">\n        <path d=\"M 118 150 q 10 30 -6 55 q 6 8 18 6 q 12 -28 4 -60 z\" fill=\"#e8c9a0\" stroke=\"#c9a877\" stroke-width=\"2\"/>\n        <!-- 脚踩踏板 -->\n        <ellipse cx=\"120\" cy=\"212\" rx=\"16\" ry=\"7\" fill=\"#e8a04c\"/>\n      </g>\n\n      <!-- 身体（带起伏动画） -->\n      <g class=\"pelican-body\">\n        <!-- 身体主体 -->\n        <ellipse cx=\"110\" cy=\"120\" rx=\"60\" ry=\"46\" fill=\"#f5f0e1\" stroke=\"#d8cfae\" stroke-width=\"3\"/>\n        <!-- 胸脯 -->\n        <ellipse cx=\"135\" cy=\"135\" rx=\"30\" ry=\"32\" fill=\"#ffffff\"/>\n        <!-- 翅膀（拍动） -->\n        <g class=\"wing\">\n          <path d=\"M 95 105 q -25 25 5 55 q 30 -8 40 -35 q -25 -20 -45 -20 z\" fill=\"#e8e0cc\" stroke=\"#cfc4a5\" stroke-width=\"2\"/>\n          <path d=\"M 100 118 q -10 15 5 30\" stroke=\"#cfc4a5\" stroke-width=\"2\" fill=\"none\"/>\n        </g>\n        <!-- 脖子 -->\n        <path d=\"M 150 95 q 40 -35 60 -55\" stroke=\"#f5f0e1\" stroke-width=\"26\" fill=\"none\" stroke-linecap=\"round\"/>\n        <path d=\"M 150 95 q 40 -35 60 -55\" stroke=\"#d8cfae\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" opacity=\"0.4\"/>\n      </g>\n\n      <!-- 前腿（近侧，踩踏板，动画） -->\n      <g class=\"leg-front\">\n        <path d=\"M 125 155 q 8 30 -8 52 q 8 8 20 6 q 10 -26 2 -56 z\" fill=\"#f0d2a8\" stroke=\"#c9a877\" stroke-width=\"2\"/>\n        <ellipse cx=\"128\" cy=\"215\" rx=\"17\" ry=\"8\" fill=\"#f0a850\"/>\n      </g>\n\n      <!-- 头（在身体组外避免被bodyBob带着抖，但加轻微） -->\n      <g class=\"pelican-body\">\n        <!-- 头 -->\n        <circle cx=\"215\" cy=\"30\" r=\"26\" fill=\"#f5f0e1\" stroke=\"#d8cfae\" stroke-width=\"3\"/>\n        <!-- 头顶小绒毛 -->\n        <path d=\"M 205 8 q 6 -10 14 -2 q 4 -10 12 -4\" stroke=\"#d8cfae\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n        <!-- 眼睛 -->\n        <circle cx=\"222\" cy=\"24\" r=\"4.5\" fill=\"#2d3436\"/>\n        <circle cx=\"223.5\" cy=\"22.5\" r=\"1.5\" fill=\"#fff\"/>\n        <!-- 腮红 -->\n        <ellipse cx=\"232\" cy=\"36\" rx=\"6\" ry=\"3.5\" fill=\"#ffb3c1\" opacity=\"0.7\"/>\n        <!-- 大嘴（鹈鹕标志性大喙+喉囊） -->\n        <path d=\"M 235 30 q 40 5 55 20 q -10 22 -50 12 q -12 -8 -12 -22 z\" fill=\"#ffb142\" stroke=\"#e08a2e\" stroke-width=\"2\"/>\n        <!-- 喉囊下垂 -->\n        <path d=\"M 238 48 q 8 26 30 24 q 10 -2 14 -14 q -18 -10 -44 -10 z\" fill=\"#ff9f45\" stroke=\"#e08a2e\" stroke-width=\"2\"/>\n        <!-- 嘴里的鱼 -->\n        <path d=\"M 262 62 q 12 -8 22 0 q -10 8 -22 0 z\" fill=\"#6cc7e8\" stroke=\"#3a94b5\" stroke-width=\"1.5\"/>\n        <circle cx=\"280\" cy=\"62\" r=\"1.5\" fill=\"#2d3436\"/>\n      </g>\n\n      <!-- 抓车把的前腿（从脖子下方伸到车把） -->\n      <path d=\"M 160 110 q 30 -20 45 -22\" stroke=\"#f0d2a8\" stroke-width=\"14\" fill=\"none\" stroke-linecap=\"round\"/>\n      <path d=\"M 160 110 q 30 -20 45 -22\" stroke=\"#c9a877\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\" opacity=\"0.4\"/>\n      <!-- 爪子 -->\n      <ellipse cx=\"206\" cy=\"88\" rx=\"12\" ry=\"8\" fill=\"#f0a850\" stroke=\"#c9783a\" stroke-width=\"1.5\"/>\n\n    </g>\n  </svg>\n</div>\n</body>\n</html>\n"
