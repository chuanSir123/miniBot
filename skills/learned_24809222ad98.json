y\" values=\"502;480.8;472;480.8;502;523.2;532;523.2;502\" dur=\"1.2s\" repeatCount=\"indefinite\"/>\n    </circle>\n  </g>\n\n  <!-- 自行车 -->\n  <g>\n    <!-- 后轮 -->\n    <g>\n      <circle cx=\"300\" cy=\"502\" r=\"58\" fill=\"none\" stroke=\"#263238\" stroke-width=\"9\"/>\n      <circle cx=\"300\" cy=\"502\" r=\"40\" fill=\"none\" stroke=\"#90a4ae\" stroke-width=\"3\"/>\n      <g stroke=\"#b0bec5\" stroke-width=\"3\">\n        <line x1=\"300\" y1=\"462\" x2=\"300\" y2=\"542\"/>\n        <line x1=\"260\" y1=\"502\" x2=\"340\" y2=\"502\"/>\n        <line x1=\"272\" y1=\"474\" x2=\"328\" y2=\"530\"/>\n        <line x1=\"272\" y1=\"530\" x2=\"328\" y2=\"474\"/>\n        <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 300 502\" to=\"360 300 502\" dur=\"1.2s\" repeatCount=\"indefinite\"/>\n      </g>\n      <circle cx=\"300\" cy=\"502\" r=\"5\" fill=\"#263238\"/>\n    </g>\n    <!-- 前轮 -->\n    <g>\n      <circle cx=\"560\" cy=\"502\" r=\"58\" fill=\"none\" stroke=\"#263238\" stroke-width=\"9\"/>\n      <circle cx=\"560\" cy=\"502\" r=\"40\" fill=\"none\" stroke=\"#90a4ae\" stroke-width=\"3\"/>\n      <g stroke=\"#b0bec5\" stroke-width=\"3\">\n        <line x1=\"560\" y1=\"462\" x2=\"560\" y2=\"542\"/>\n        <line x1=\"520\" y1=\"502\" x2=\"600\" y2=\"502\"/>\n        <line x1=\"532\" y1=\"474\" x2=\"588\" y2=\"530\"/>\n        <line x1=\"532\" y1=\"530\" x2=\"588\" y2=\"474\"/>\n        <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 560 502\" to=\"360 560 502\" dur=\"1.2s\" repeatCount=\"indefinite\"/>\n      </g>\n      <circle cx=\"560\" cy=\"502\" r=\"5\" fill=\"#263238\"/>\n    </g>\n    <!-- 车架 -->\n    <g stroke=\"#e63946\" stroke-width=\"7\" stroke-linecap=\"round\">\n      <line x1=\"300\" y1=\"502\" x2=\"415\" y2=\"502\"/>\n      <line x1=\"415\" y1=\"502\" x2=\"356\" y2=\"393\"/>\n      <line x1=\"300\" y1=\"502\" x2=\"358\" y2=\"400\"/>\n      <line x1=\"415\" y1=\"502\" x2=\"520\" y2=\"397\"/>\n      <line x1=\"358\" y1=\"399\" x2=\"518\" y2=\"396\"/>\n      <line x1=\"560\" y1=\"502\" x2=\"520\" y2=\"397\"/>\n    </g>\n    <circle cx=\"415\" cy=\"502\" r=\"11\" fill=\"none\" stroke=\"#37474f\" stroke-width=\"3\"/>\n    <!-- 车座 -->\n    <rect x=\"333\" y=\"388\" width=\"46\" height=\"10\" rx=\"5\" fill=\"#263238\"/>\n    <!-- 车把 -->\n    <path d=\"M 520 397 L 524 376 Q 526 368 536 369 L 550 372\" fill=\"none\" stroke=\"#263238\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n    <!-- 曲柄（旋转） -->\n    <g>\n      <line x1=\"415\" y1=\"502\" x2=\"445\" y2=\"502\" stroke=\"#37474f\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n      <line x1=\"415\" y1=\"502\" x2=\"385\" y2=\"502\" stroke=\"#37474f\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n      <circle cx=\"415\" cy=\"502\" r=\"7\" fill=\"#37474f\"/>\n      <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 415 502\" to=\"360 415 502\" dur=\"1.2s\" repeatCount=\"indefinite\"/>\n    </g>\n  </g>\n\n  <!-- 鹈鹕 -->\n  <g class=\"body\">\n    <!-- 尾巴 -->\n    <path d=\"M 296 350 L 260 360 L 292 374 Z\" fill=\"#eceff1\"/>\n    <!-- 身体 -->\n    <ellipse cx=\"345\" cy=\"345\" rx=\"55\" ry=\"42\" fill=\"#ffffff\" stroke=\"#cfd8dc\" stroke-width=\"2\"/>\n    <!-- 翅膀（扑动） -->\n    <g class=\"wing\">\n      <ellipse cx=\"350\" cy=\"350\" rx=\"30\" ry=\"19\" transform=\"rotate(-20 350 350)\" fill=\"#b0bec5\" stroke=\"#90a4ae\" stroke-width=\"1.5\"/>\n    </g>\n    <!-- 脖子 + 头 + 大嘴（点头） -->\n    <g class=\"head\">\n      <path d=\"M 358 322 C 350 292 386 290 394 258\" fill=\"none\" stroke=\"#d5dde3\" stroke-width=\"23\" stroke-linecap=\"round\"/>\n      <path d=\"M 358 322 C 350 292 386 290 394 258\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"19\" stroke-linecap=\"round\"/>\n      <circle cx=\"395\" cy=\"258\" r=\"24\" fill=\"#ffffff\" stroke=\"#d5dde3\" stroke-width=\"2\"/>\n      <!-- 上喙 -->\n      <path d=\"M 406 246 L 476 258 L 408 260 Z\" fill=\"#f4a261\"/>\n      <!-- 喉囊 -->\n      <path d=\"M 408 2