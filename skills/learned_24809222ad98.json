        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>鹈鹕骑自行车</title>\n<style>\n  html,body{margin:0;height:100%;background:#0e2a3a;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:\"Microsoft YaHei\",\"PingFang SC\",sans-serif;}\n  svg{width:min(96vw,1000px);height:auto;display:block;border-radius:18px;box-shadow:0 12px 40px rgba(0,0,0,.35);}\n  .caption{color:#9fd8ff;margin-top:12px;font-size:14px;letter-spacing:3px;}\n\n  /* 云朵飘过 */\n  @keyframes drift{from{transform:translateX(980px)}to{transform:translateX(-220px)}}\n  .cloud{animation:drift linear infinite;}\n  .c1{animation-duration:24s;animation-delay:-9s;}\n  .c2{animation-duration:32s;animation-delay:-21s;}\n  .c3{animation-duration:27s;animation-delay:-4s;}\n\n  /* 路面虚线后移（体现前进） */\n  @keyframes dashmove{from{transform:translateX(0)}to{transform:translateX(-130px)}}\n  .dashes{animation:dashmove .42s linear infinite;}\n\n  /* 速度线 */\n  @keyframes whoosh{0%{opacity:0;transform:translateX(0)}30%{opacity:.75}100%{opacity:0;transform:translateX(-90px)}}\n  .speed{animation:whoosh 1s linear infinite;}\n  .s2{animation-delay:.35s;}\n  .s3{animation-delay:.7s;}\n\n  /* 翅膀扑动 */\n  @keyframes flap{from{transform:rotate(-14deg)}to{transform:rotate(18deg)}}\n  .wing{animation:flap .6s ease-in-out infinite alternate;transform-origin:325px 338px;}\n\n  /* 头部点头 */\n  @keyframes headbob{from{transform:rotate(-3.5deg)}to{transform:rotate(3.5deg)}}\n  .head{animation:headbob 1.2s ease-in-out infinite alternate;transform-origin:358px 322px;}\n\n  /* 身体上下轻微起伏 */\n  @keyframes bodybob{from{transform:translateY(0)}to{transform:translateY(3px)}}\n  .body{animation:bodybob .6s ease-in-out infinite alternate;}\n</style>\n</head>\n<body>\n<svg viewBox=\"0 0 900 600\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"鹈鹕骑自行车\">\n  <defs>\n    <linearGradient id=\"sky\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n      <stop offset=\"0\" stop-color=\"#6ec6ff\"/>\n      <stop offset=\"1\" stop-color=\"#d8f3ff\"/>\n    </linearGradient>\n  </defs>\n\n  <!-- 天空 -->\n  <rect x=\"0\" y=\"0\" width=\"900\" height=\"440\" fill=\"url(#sky)\"/>\n\n  <!-- 太阳（光芒缓慢旋转） -->\n  <g>\n    <g stroke=\"#ffd54f\" stroke-width=\"6\" stroke-linecap=\"round\">\n      <line x1=\"840\" y1=\"95\" x2=\"858\" y2=\"95\"/>\n      <line x1=\"825.4\" y1=\"130.4\" x2=\"838.1\" y2=\"143.1\"/>\n      <line x1=\"790\" y1=\"145\" x2=\"790\" y2=\"163\"/>\n      <line x1=\"754.6\" y1=\"130.4\" x2=\"741.9\" y2=\"143.1\"/>\n      <line x1=\"740\" y1=\"95\" x2=\"722\" y2=\"95\"/>\n      <line x1=\"754.6\" y1=\"59.6\" x2=\"741.9\" y2=\"46.9\"/>\n      <line x1=\"790\" y1=\"45\" x2=\"790\" y2=\"27\"/>\n      <line x1=\"825.4\" y1=\"59.6\" x2=\"838.1\" y2=\"46.9\"/>\n      <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 790 95\" to=\"360 790 95\" dur=\"40s\" repeatCount=\"indefinite\"/>\n    </g>\n    <circle cx=\"790\" cy=\"95\" r=\"40\" fill=\"#ffd54f\"/>\n  </g>\n\n  <!-- 云朵 -->\n  <g class=\"cloud c1\" fill=\"#ffffff\" opacity=\"0.92\">\n    <circle cx=\"20\" cy=\"112\" r=\"22\"/><circle cx=\"48\" cy=\"100\" r=\"30\"/><circle cx=\"78\" cy=\"110\" r=\"24\"/>\n    <rect x=\"8\" y=\"110\" width=\"86\" height=\"22\" rx=\"11\"/>\n  </g>\n  <g class=\"cloud c2\" fill=\"#ffffff\" opacity=\"0.9\">\n    <circle cx=\"15\" cy=\"196\" r=\"16\"/><circle cx=\"38\" cy=\"188\" r=\"22\"/><circle cx=\"60\" cy=\"196\" r=\"17\"/>\n    <rect x=\"5\" y=\"194\" width=\"70\" height=\"18\" rx=\"9\"/>\n  </g>\n  <g class=\"cloud c3\" fill=\"#ffffff\" opacity=\"0.95\">\n    <circle cx=\"18\" cy=\"66\" r=\"18\"/><circle cx=\"42\" cy=\"56\" r=\"25\"/><circle cx=\"68\" cy=\"66\" r=\"19\"/>\n    <rect x=\"8\" y=\"64\" width=\"72\" height=\"20\" rx=\"10\"/>\n  </g>\n\n  <!-- 远山 -->\n  <path d=\"M0 440 Q 110 372 230 440 T 470 440 T 710 440 T 950 440 Z\" fill=\"#a5d6a7\"/>\n  <path