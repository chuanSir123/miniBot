        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>鹈鹕骑自行车 🚲</title>\n<style>\n  html,body{\n    margin:0; padding:0;\n    background:linear-gradient(#8fd3ff,#e8f7ff);\n    display:flex; align-items:center; justify-content:center;\n    height:100vh; overflow:hidden;\n    font-family:\"Microsoft YaHei\",sans-serif;\n  }\n  .title{\n    position:absolute; top:18px; left:0; right:0;\n    text-align:center; color:#1a5a8a; font-weight:bold;\n    font-size:22px; text-shadow:0 2px 4px rgba(255,255,255,.6);\n  }\n  svg{ width:100vw; height:100vh; display:block; }\n</style>\n</head>\n<body>\n<div class=\"title\">🐦 鹈鹕骑自行车啦～ 🚲</div>\n<svg viewBox=\"0 0 800 500\" preserveAspectRatio=\"xMidYMid slice\">\n  <defs>\n    <!-- 云朵 -->\n    <g id=\"cloud\">\n      <ellipse cx=\"0\" cy=\"0\" rx=\"34\" ry=\"18\" fill=\"#ffffff\" opacity=\"0.95\"/>\n      <ellipse cx=\"26\" cy=\"4\" rx=\"26\" ry=\"14\" fill=\"#ffffff\" opacity=\"0.95\"/>\n      <ellipse cx=\"-26\" cy=\"5\" rx=\"24\" ry=\"13\" fill=\"#ffffff\" opacity=\"0.95\"/>\n      <ellipse cx=\"6\" cy=\"-10\" rx=\"20\" ry=\"13\" fill=\"#ffffff\" opacity=\"0.95\"/>\n    </g>\n  </defs>\n\n  <!-- 天空 -->\n  <rect x=\"0\" y=\"0\" width=\"800\" height=\"500\" fill=\"url(#sky)\"/>\n  <linearGradient id=\"sky\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n    <stop offset=\"0\" stop-color=\"#9fd8ff\"/>\n    <stop offset=\"1\" stop-color=\"#e8f7ff\"/>\n  </linearGradient>\n\n  <!-- 太阳 -->\n  <g>\n    <circle cx=\"700\" cy=\"80\" r=\"34\" fill=\"#ffe08a\">\n      <animate attributeName=\"r\" values=\"34;38;34\" dur=\"4s\" repeatCount=\"indefinite\"/>\n    </circle>\n    <circle cx=\"700\" cy=\"80\" r=\"46\" fill=\"#ffe08a\" opacity=\"0.35\">\n      <animate attributeName=\"r\" values=\"46;54;46\" dur=\"4s\" repeatCount=\"indefinite\"/>\n    </circle>\n  </g>\n\n  <!-- 远山 -->\n  <path d=\"M0,360 L120,270 L240,360 Z\" fill=\"#bfe3c9\"/>\n  <path d=\"M160,360 L300,240 L440,360 Z\" fill=\"#a9d8ba\"/>\n  <path d=\"M380,360 L520,280 L660,360 Z\" fill=\"#bfe3c9\"/>\n  <path d=\"M560,360 L700,250 L800,360 Z\" fill=\"#9fd0af\"/>\n\n  <!-- 地面/马路 -->\n  <rect x=\"0\" y=\"360\" width=\"800\" height=\"140\" fill=\"#5f9e6e\"/>\n  <rect x=\"0\" y=\"380\" width=\"800\" height=\"120\" fill=\"#4a4a52\"/>\n  <!-- 马路虚线（滚动） -->\n  <g>\n    <rect x=\"0\" y=\"438\" width=\"50\" height=\"8\" fill=\"#f4d03f\"/>\n    <rect x=\"100\" y=\"438\" width=\"50\" height=\"8\" fill=\"#f4d03f\"/>\n    <rect x=\"200\" y=\"438\" width=\"50\" height=\"8\" fill=\"#f4d03f\"/>\n    <rect x=\"300\" y=\"438\" width=\"50\" height=\"8\" fill=\"#f4d03f\"/>\n    <rect x=\"400\" y=\"438\" width=\"50\" height=\"8\" fill=\"#f4d03f\"/>\n    <rect x=\"500\" y=\"438\" width=\"50\" height=\"8\" fill=\"#f4d03f\"/>\n    <rect x=\"600\" y=\"438\" width=\"50\" height=\"8\" fill=\"#f4d03f\"/>\n    <rect x=\"700\" y=\"438\" width=\"50\" height=\"8\" fill=\"#f4d03f\"/>\n    <animateTransform attributeName=\"transform\" type=\"translate\"\n      from=\"0 0\" to=\"-100 0\" dur=\"0.7s\" repeatCount=\"indefinite\"/>\n  </g>\n\n  <!-- 云（缓慢飘动） -->\n  <use href=\"#cloud\" x=\"150\" y=\"90\">\n    <animateTransform attributeName=\"transform\" type=\"translate\"\n      from=\"-100 0\" to=\"900 0\" dur=\"35s\" repeatCount=\"indefinite\"/>\n  </use>\n  <use href=\"#cloud\" x=\"420\" y=\"140\" transform=\"scale(0.8)\">\n    <animateTransform attributeName=\"transform\" type=\"translate\"\n      from=\"-100 0\" to=\"1000 0\" dur=\"45s\" repeatCount=\"indefinite\"/>\n  </use>\n\n  <!-- ===== 鹈鹕 + 自行车 整体（上下轻微颠簸） ===== -->\n  <g id=\"rider\">\n    <animateTransform attributeName=\"transform\" type=\"translate\"\n      values=\"0 0; 0 -4; 0 0; 0 3; 0 0\" dur=\"0.9s\" repeatCount=\"indefinite\"/>\n\n    <!-- ===== 自行车 ===== -->\n    <g id=\"bike\">\n      <!-- 后轮 -->\n      <g>\n        <circle cx=\"250\" cy=\"420\" r=\"55\" fill=\"none\" stroke=\"#2b2b33\" stroke-width=\"8\"/>\n        <circle cx=\"250\" cy=\"420\" r=\"46\" fill=\"none\" stroke=\"#555\" stroke-width=\"2\"/>\n        <!-- 辐条（旋转） -->\n        <g>\n          <line x1=\"250\" y1=\"374\" x2=\"250\" y2=\"466\" stroke=\"#888\" stroke-width=\"2\"/>\n          <line x1=\"204\" y1=\"420\" x2=\"296\" y2=\"420\" stroke=\"#888\" stroke-width=\"2\"/>\n          <line x1=\"217\" y1=\"387\" x2=\"283\" y2=\"453\" stroke=\"#888\" stroke-width=\"2\"/>\n          <line x1=\"283\" y1=\"387\" x2=\"217\" y2=\"453\" stroke=\"#888\" stroke-width=\"2\"/>\n          <animateTransform attributeName=\"transform\" type=\"rotate\"\n            from=\"0 250 420\" to=\"360 250 420\" dur=\"1s\" repeatCount=\"indefinite\"/>\n        </g>\n        <circle cx=\"250\" cy=\"420\" r=\"7\" fill=\"#2b2b33\"/>\n      </g>\n\n      <!-- 前轮 -->\n      <g>\n        <circle cx=\"470\" cy=\"420\" r=\"55\" fill=\"none\" stroke=\"#2b2b33\" stroke-width=\"8\"/>\n        <circle cx=\"470\" cy=\"420\" r=\"46\" fill=\"none\" stroke=\"#555\" stroke-width=\"2\"/>\n        <g>\n          <line x1=\"470\" y1=\"374\" x2=\"470\" y2=\"466\" stroke=\"#888\" stroke-width=\"2\"/>\n          <line x1=\"424\" y1=\"420\" x2=\"516\" y2=\"420\" stroke=\"#888\" stroke-width=\"2\"/>\n          <line x1=\"437\" y1=\"387\" x2=\"503\" y2=\"453\" stroke=\"#888\" stroke-width=\"2\"/>\n          <line x1=\"503\" y1=\"387\" x2=\"437\" y2=\"453\" stroke=\"#888\" stroke-width=\"2\"/>\n          <animateTransform attributeName=\"transform\" type=\"rotate\"\n            from=\"0 470 420\" to=\"360 470 420\" dur=\"1s\" repeatCount=\"indefinite\"/>\n        </g>\n        <circle cx=\"470\" cy=\"420\" r=\"7\" fill=\"#2b2b33\"/>\n      </g>\n\n      <!-- 车架 -->\n      <g stroke=\"#e74c3c\" stroke-width=\"7\" fill=\"none\" stroke-linecap=\"round\">\n        <!-- 后轮轴 -> 中轴 -->\n        <line x1=\"250\" y1=\"420\" x2=\"350\" y2=\"420\"/>\n        <!-- 中轴 -> 座管 -->\n        <line x1=\"350\" y1=\"420\" x2=\"330\" y2=\"330\"/>\n        <!-- 后轮轴 -> 座管 -->\n        <line x1=\"250\" y1=\"420\" x2=\"330\" y2=\"330\"/>\n        <!-- 中轴 -> 前叉 -->\n        <line x1=\"350\" y1=\"420\" x2=\"455\" y2=\"345\"/>\n        <!-- 座管 -> 前叉(上管) -->\n        <line x1=\"330\" y1=\"330\" x2=\"455\" y2=\"345\"/>\n        <!-- 前叉 -> 前轮 -->\n        <line x1=\"455\" y1=\"345\" x2=\"470\" y2=\"420\"/>\n      </g>\n\n      <!-- 车座 -->\n      <rect x=\"305\" y=\"318\" width=\"52\" height=\"14\" rx=\"7\" fill=\"#333\"/>\n      <!-- 车把 -->\n      <path d=\"M455,345 L470,315\" stroke=\"#333\" stroke-width=\"6\" fill=\"none\" stroke-linecap=\"round\"/>\n      <path d=\"M470,315 L492,312\" stroke=\"#333\" stroke-width=\"8\" fill=\"none\" stroke-linecap=\"round\"/>\n\n      <!-- 脚踏+曲柄 -->\n      <g>\n        <circle cx=\"350\" cy=\"420\" r=\"10\" fill=\"#222\"/>\n        <g>\n          <line x1=\"350\" y1=\"420\" x2=\"382\" y2=\"440\" stroke=\"#222\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n          <rect x=\"376\" y=\"434\" width=\"22\" height=\"10\" rx=\"3\" fill=\"#111\"/>\n          <line x1=\"350\" y1=\"420\" x2=\"318\" y2=\"400\" stroke=\"#222\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n          <rect x=\"306\" y=\"394\" width=\"22\" height=\"10\" rx=\"3\" fill=\"#111\"/>\n          <animateTransform attributeName=\"transform\" type=\"rotate\"\n            from=\"0 350 420\" to=\"360 350 420\" dur=\"1s\" repeatCount=\"indefinite\"/>\n        </g>\n      </g>\n    </g>\n\n    <!-- ===== 鹈鹕 ===== -->\n    <g id=\"pelican\">\n      <!-- 身体 -->\n      <ellipse cx=\"330\" cy=\"300\" rx=\"52\" ry=\"42\" fill=\"#f4f9ff\" stroke=\"#cfd8e3\" stroke-width=\"3\"/>\n      <!-- 翅膀（拍动） -->\n      <g>\n        <path d=\"M300,295 Q270,270 285,305 Q295,315 315,305 Z\" fill=\"#dce8f5\" stroke=\"#cfd8e3\" stroke-width=\"2\">\n          <animateTransform attributeName=\"transform\" type=\"rotate\"\n            values=\"0 300 300; -12 300 300; 0 300 300\" dur=\"0.9s\" repeatCount=\"indefinite\"/>\n        </path>\n      </g>\n      <!-- 脖子 -->\n      <path d=\"M360,290 Q400,270 405,235 Q408,210 395,195\" fill=\"none\"\n            stroke=\"#f4f9ff\" stroke-width=\"22\" stroke-linecap=\"round\"/>\n      <path d=\"M360,290 Q400,270 405,235 Q408,210 395,195\" fill=\"none\"\n            stroke=\"#cfd8e3\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      <!-- 头 -->\n      <circle cx=\"395\" cy=\"190\" r=\"26\" fill=\"#f4f9ff\" stroke=\"#cfd8e3\" stroke-width=\"3\"/>\n      <!-- 眼睛 -->\n      <circle cx=\"402\" cy=\"185\" r=\"4\" fill=\"#222\"/>\n      <circle cx=\"403\" cy=\"184\" r=\"1.5\" fill=\"#fff\"/>\n      <!-- 大嘴（鹈鹕特征：下垂的喉囊） -->\n      <path d=\"M415,192 Q455,196 468,206 Q460,220 432,214 Q418,210 415,200 Z\"\n            fill=\"#f5a623\" stroke=\"#d9820f\" stroke-width=\"2\"/>\n      <!-- 喉囊（鼓起，呼吸感） -->\n      <path d=\"M432,214 Q445,235 430,240 Q420,235 425,218 Z\" fill=\"#f5a623\" stroke=\"#d9820f\" stroke-width=\"2\">\n        <animate attributeName=\"d\"\n          values=\"M432,214 Q445,235 430,240 Q420,235 425,218 Z;\n                  M432,214 Q450,242 430,246 Q418,238 425,218 Z;\n                  M432,214 Q445,235 430,240 Q420,235 425,218 Z\"\n          dur=\"1.2s\" repeatCount=\"indefinite\"/>\n      </path>\n      <!-- 腿（蹬踏，摆动） -->\n      <g>\n        <path d=\"M335,330 L350,400 L372,435\" fill=\"none\" stroke=\"#f5a623\" stroke-width=\"8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <animate attributeName=\"d\"\n            values=\"M335,330 L350,400 L372,435;\n                    M335,330 L345,405 L322,405;\n                    M335,330 L350,400 L372,435\"\n            dur=\"1s\" repeatCount=\"indefinite\"/>\n        </path>\n      </g>\n    </g>\n  </g>\n</svg>\n</body>\n</html>\n"
      }
