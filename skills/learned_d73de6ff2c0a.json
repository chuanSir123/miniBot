        "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>骑自行车的鹈鹕</title>\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: linear-gradient(#8fd3ff, #d8f0ff 70%, #bde6c8 70%, #8fd19e);\n    font-family: \"Microsoft YaHei\", sans-serif;\n    overflow: hidden;\n  }\n  .stage {\n    width: 900px;\n    max-width: 95vw;\n    text-align: center;\n  }\n  h1 {\n    color: #2a5c8a;\n    font-size: 26px;\n    margin: 0 0 10px;\n    text-shadow: 0 2px 0 rgba(255,255,255,.6);\n  }\n  svg { width: 100%; height: auto; display: block; }\n</style>\n</head>\n<body>\n<div class=\"stage\">\n  <h1>🚴 骑自行车的鹈鹕</h1>\n  <svg viewBox=\"0 0 900 520\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"一只鹈鹕骑着自行车\">\n    <!-- 太阳 -->\n    <circle cx=\"790\" cy=\"90\" r=\"46\" fill=\"#ffd93b\">\n      <animate attributeName=\"r\" values=\"46;52;46\" dur=\"3s\" repeatCount=\"indefinite\"/>\n    </circle>\n    <!-- 远山 -->\n    <path d=\"M0 360 Q180 300 360 350 T720 350 T900 340 L900 520 L0 520 Z\" fill=\"#a9e2b4\" opacity=\"0.6\"/>\n    <!-- 云（缓慢飘动） -->\n    <g fill=\"#ffffff\" opacity=\"0.9\">\n      <g>\n        <ellipse cx=\"200\" cy=\"90\" rx=\"55\" ry=\"26\"/>\n        <ellipse cx=\"250\" cy=\"80\" rx=\"45\" ry=\"30\"/>\n        <ellipse cx=\"160\" cy=\"80\" rx=\"40\" ry=\"24\"/>\n        <animateTransform attributeName=\"transform\" type=\"translate\" from=\"-80 0\" to=\"1000 0\" dur=\"38s\" repeatCount=\"indefinite\"/>\n      </g>\n      <g opacity=\"0.8\">\n        <ellipse cx=\"520\" cy=\"140\" rx=\"45\" ry=\"22\"/>\n        <ellipse cx=\"560\" cy=\"132\" rx=\"38\" ry=\"26\"/>\n        <animateTransform attributeName=\"transform\" type=\"translate\" from=\"-200 0\" to=\"1000 0\" dur=\"30s\" repeatCount=\"indefinite\"/>\n      </g>\n    </g>\n\n    <!-- 地面滚动线（模拟前进） -->\n    <g stroke=\"#5a8f52\" stroke-width=\"4\" stroke-linecap=\"round\">\n      <line x1=\"0\" y1=\"470\" x2=\"900\" y2=\"470\" stroke=\"#4c7d45\" stroke-width=\"8\"/>\n    </g>\n    <g stroke=\"#6faa63\" stroke-width=\"3\" stroke-dasharray=\"40 30\">\n      <line x1=\"0\" y1=\"490\" x2=\"900\" y2=\"490\">\n        <animate attributeName=\"stroke-dashoffset\" from=\"0\" to=\"-140\" dur=\"0.6s\" repeatCount=\"indefinite\"/>\n      </line>\n    </g>\n    <!-- 路边小草 / 树（向后移动） -->\n    <g fill=\"#4c9a4f\">\n      <g>\n        <path d=\"M0 470 q12 -34 0 -40 q-12 6 0 40\"/>\n        <path d=\"M30 470 q12 -30 0 -36 q-12 6 0 36\"/>\n      </g>\n      <g id=\"scenery\">\n        <circle cx=\"120\" cy=\"430\" r=\"34\" fill=\"#3f8f4a\"/>\n        <rect x=\"114\" y=\"430\" width=\"12\" height=\"42\" fill=\"#7a4f2a\"/>\n        <circle cx=\"360\" cy=\"440\" r=\"26\" fill=\"#4aa055\"/>\n        <rect x=\"355\" y=\"440\" width=\"10\" height=\"32\" fill=\"#7a4f2a\"/>\n        <circle cx=\"640\" cy=\"425\" r=\"40\" fill=\"#3f8f4a\"/>\n        <rect x=\"634\" y=\"425\" width=\"13\" height=\"48\" fill=\"#7a4f2a\"/>\n        <circle cx=\"840\" cy=\"445\" r=\"24\" fill=\"#4aa055\"/>\n        <rect x=\"835\" y=\"445\" width=\"10\" height=\"30\" fill=\"#7a4f2a\"/>\n        <animateTransform attributeName=\"transform\" type=\"translate\" from=\"0 0\" to=\"-900 0\" dur=\"1.6s\" repeatCount=\"indefinite\"/>\n      </g>\n    </g>\n\n    <!-- ============ 自行车 + 鹈鹕 整体（轻微上下颠簸） ============ -->\n    <g>\n      <animateTransform attributeName=\"transform\" type=\"translate\"\n        values=\"0 0; 0 -4; 0 0; 0 -3; 0 0\" dur=\"0.55s\" repeatCount=\"indefinite\"/>\n\n      <!-- 车轮 -->\n      <!-- 后轮 -->\n      <g transform=\"translate(250,360)\">\n        <g>\n          <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 0 0\" to=\"360 0 0\" dur=\"0.8s\" repeatCount=\"indefinite\"/>\n          <circle r=\"70\" fill=\"none\" stroke=\"#2b2b2b\" stroke-width=\"12\"/>\n          <circle r=\"70\" fill=\"none\" stroke=\"#555\" stroke-width=\"2\"/>\n          <g stroke=\"#cfd6dd\" stroke-width=\"4\">\n            <line x1=\"-70\" y1=\"0\" x2=\"70\" y2=\"0\"/>\n            <line x1=\"0\" y1=\"-70\" x2=\"0\" y2=\"70\"/>\n            <line x1=\"-49\" y1=\"-49\" x2=\"49\" y2=\"49\"/>\n            <line x1=\"49\" y1=\"-49\" x2=\"-49\" y2=\"49\"/>\n          </g>\n          <circle r=\"12\" fill=\"#333\"/>\n        </g>\n      </g>\n      <!-- 前轮 -->\n      <g transform=\"translate(560,360)\">\n        <g>\n          <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 0 0\" to=\"360 0 0\" dur=\"0.8s\" repeatCount=\"indefinite\"/>\n          <circle r=\"70\" fill=\"none\" stroke=\"#2b2b2b\" stroke-width=\"12\"/>\n          <circle r=\"70\" fill=\"none\" stroke=\"#555\" stroke-width=\"2\"/>\n          <g stroke=\"#cfd6dd\" stroke-width=\"4\">\n            <line x1=\"-70\" y1=\"0\" x2=\"70\" y2=\"0\"/>\n            <line x1=\"0\" y1=\"-70\" x2=\"0\" y2=\"70\"/>\n            <line x1=\"-49\" y1=\"-49\" x2=\"49\" y2=\"49\"/>\n            <line x1=\"49\" y1=\"-49\" x2=\"-49\" y2=\"49\"/>\n          </g>\n          <circle r=\"12\" fill=\"#333\"/>\n        </g>\n      </g>\n\n      <!-- 车架 -->\n      <g stroke=\"#e0433c\" stroke-width=\"12\" stroke-linecap=\"round\" fill=\"none\">\n        <!-- 后三角 -->\n        <line x1=\"250\" y1=\"360\" x2=\"360\" y2=\"360\"/>   <!-- 后轮轴-中轴 -->\n        <line x1=\"250\" y1=\"360\" x2=\"300\" y2=\"270\"/>   <!-- 后轮轴-座管 -->\n        <line x1=\"360\" y1=\"360\" x2=\"300\" y2=\"270\"/>   <!-- 中轴-座管 -->\n        <!-- 主梁 -->\n        <line x1=\"300\" y1=\"270\" x2=\"500\" y2=\"265\"/>   <!-- 座管-头管 -->\n        <line x1=\"360\" y1=\"360\" x2=\"500\" y2=\"265\"/>   <!-- 中轴-头管 -->\n        <!-- 前叉 -->\n        <line x1=\"500\" y1=\"265\" x2=\"560\" y2=\"360\"/>   <!-- 头管-前轮轴 -->\n      </g>\n      <!-- 车把 -->\n      <g stroke=\"#333\" stroke-width=\"10\" stroke-linecap=\"round\" fill=\"none\">\n        <line x1=\"500\" y1=\"265\" x2=\"470\" y2=\"235\"/>\n        <path d=\"M470 235 q-20 -10 -34 6\"/>\n      </g>\n      <!-- 座椅 -->\n      <g>\n        <line x1=\"300\" y1=\"270\" x2=\"292\" y2=\"250\" stroke=\"#333\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n        <ellipse cx=\"292\" cy=\"248\" rx=\"34\" ry=\"12\" fill=\"#2b2b2b\"/>\n      </g>\n      <!-- 牙盘 / 脚踏曲柄（旋转） -->\n      <g transform=\"translate(360,360)\">\n        <g>\n          <animateTransform attributeName=\"transform\" type=\"rotate\" from=\"0 0 0\" to=\"360 0 0\" dur=\"0.8s\" repeatCount=\"indefinite\"/>\n          <circle r=\"26\" fill=\"none\" stroke=\"#8a8a8a\" stroke-width=\"8\"/>\n          <line x1=\"0\" y1=\"-38\" x2=\"0\" y2=\"38\" stroke=\"#444\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n          <line x1=\"-38\" y1=\"0\" x2=\"38\" y2=\"0\" stroke=\"#444\" stroke-width=\"10\" stroke-linecap=\"round\"/>\n          <rect x=\"-16\" y=\"-46\" width=\"32\" height=\"14\" rx=\"4\" fill=\"#111\"/>\n          <rect x=\"-16\" y=\"32\" width=\"32\" height=\"14\" rx=\"4\" fill=\"#111\"/>\n        </g>\n      </g>\n\n      <!-- ============ 鹈鹕 ============ -->\n      <g>\n        <!-- 尾巴（后面翘起） -->\n        <path d=\"M250 250 q-45 -18 -70 -6 q25 22 55 26 q-18 12 4 26 q34 -8 40 -20 Z\"\n              fill=\"#ffffff\" stroke=\"#d7dee6\" stroke-width=\"2\"/>\n        <!-- 身体（坐在座椅上） -->\n        <ellipse cx=\"300\" cy=\"255\" rx=\"72\" ry=\"58\" fill=\"#ffffff\" stroke=\"#d7dee6\" stroke-width=\"3\"/>\n        <!-- 翅膀（贴在身上，轻微扇动） -->\n        <g>\n          <animateTransform attributeName=\"transform\" type=\"rotate\" values=\"-4 320 250; 6 320 250; -4 320 250\" dur=\"0.8s\" repeatCount=\"indefinite\"/>\n          <path d=\"M330 230 q60 4 66 44 q-40 22 -82 6 q-14 -30 16 -50 Z\"\n                fill=\"#eef3f8\" stroke=\"#c6d0da\" stroke-width=\"2\"/>\n        </g>\n\n        <!-- 后腿（踩踏板，左右交替） -->\n        <g stroke=\"#f4c542\" stroke-width=\"14\" stroke-linecap=\"round\" fill=\"none\">\n          <!-- 左腿 -->\n          <g>\n            <animateTransform attributeName=\"transform\" type=\"rotate\" values=\"18 360 360; -18 360 360; 18 360 360\" dur=\"0.8s\" repeatCount=\"indefinite\"/>\n            <path d=\"M300 300 q40 10 48 44 q4 22 -10 30\"/>\n          </g>\n          <!-- 右腿 -->\n          <g>\n            <animateTransform attributeName=\"transform\" type=\"rotate\" values=\"-18 360 360; 18 360 360; -18 360 360\" dur=\"0.8s\" repeatCount=\"indefinite\"/>\n            <path d=\"M300 300 q40 10 48 44 q4 22 -10 30\"/>\n          </g>\n        </g>\n\n        <!-- 脖子 -->\n        <path d=\"M330 235 q30 -30 55 -40\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"34\" stroke-linecap=\"round\"/>\n        <path d=\"M330 235 q30 -30 55 -40\" fill=\"none\" stroke=\"#d7dee6\" stroke-width=\"34\" stroke-linecap=\"round\" opacity=\"0.25\"/>\n\n        <!-- 头部 + 大嘴（鹈鹕特征：大喉囊） -->\n        <g transform=\"translate(385,190)\">\n          <!-- 头 -->\n          <ellipse cx=\"0\" cy=\"0\" rx=\"30\" ry=\"26\" fill=\"#ffffff\" stroke=\"#d7dee6\" stroke-width=\"3\"/>\n          <!-- 眼睛 -->\n          <circle cx=\"6\" cy=\"-6\" r=\"7\" fill=\"#2b2b2b\"/>\n          <circle cx=\"9\" cy=\"-8\" r=\"2.5\" fill=\"#ffffff\"/>\n          <!-- 上喙 -->\n          <path d=\"M20 -12 q60 -4 96 10 q-6 10 -20 12 q-40 2 -76 -8 Z\"\n                fill=\"#f6a93b\" stroke=\"#e08a1e\" stroke-width=\"2\"/>\n          <!-- 喉囊（大口袋，微微张开） -->\n          <path d=\"M20 0 q70 6 90 18 q-10 30 -46 30 q-40 0 -54 -22 q-4 -14 10 -26 Z\"\n                fill=\"#f8c46a\" stroke=\"#e08a1e\" stroke-width=\"2\"/>\n          <!-- 嘴缝线 -->\n          <path d=\"M22 2 q60 8 86 20\" fill=\"none\" stroke=\"#e08a1e\" stroke-width=\"2\"/>\n          <!-- 鼻孔 -->\n          <circle cx=\"34\" cy=\"-6\" r=\"2.5\" fill=\"#e08a1e\"/>\n        </g>\n\n        <!-- 前腿 / 手臂（握着车把，轻轻上下） -->\n        <g stroke=\"#ffffff\" stroke-width=\"16\" stroke-linecap=\"round\" fill=\"none\">\n          <animateTransform attributeName=\"transform\" type=\"translate\" values=\"0 0; 0 3; 0 0\" dur=\"0.55s\" repeatCount=\"indefinite\"/>\n          <path d=\"M345 250 q50 10 120 -12\"/>\n        </g>\n        <!-- 前爪（脚蹼握把） -->\n        <g>\n          <animateTransform attributeName=\"transform\" type=\"translate\" values=\"0 0; 0 3; 0 0\" dur=\"0.55s\" repeatCount=\"indefinite\"/>\n          <path d=\"M460 238 q-6 14 8 18 q16 4 24 -8 q-10 -14 -32 -10 Z\" fill=\"#f4c542\"/>\n        </g>\n      </g>\n\n      <!-- 速度线（表示在前进） -->\n      <g stroke=\"#ffffff\" stroke-width=\"4\" stroke-linecap=\"round\" opacity=\"0.7\">\n        <line x1=\"120\" y1=\"300\" x2=\"180\" y2=\"300\">\n          <animate attributeName=\"opacity\" values=\"0;0.8;0\" dur=\"0.5s\" repeatCount=\"indefinite\"/>\n        </line>\n        <line x1=\"100\" y1=\"330\" x2=\"170\" y2=\"330\">\n          <animate attributeName=\"opacity\" values=\"0.8;0;0.8\" dur=\"0.5s\" repeatCount=\"indefinite\"/>\n        </line>\n        <line x1=\"130\" y1=\"360\" x2=\"185\" y2=\"360\">\n          <animate attributeName=\"opacity\" values=\"0;0.7;0\" dur=\"0.5s\" begin=\"0.2s\" repeatCount=\"indefinite\"/>\n        </line>\n      </g>\n    </g>\n\n    <!-- 地面阴影 -->\n    <ellipse cx=\"400\" cy=\"470\" rx=\"200\" ry=\"14\" fill=\"#00000022\"/>\n  </svg>\n</div>\n</body>\n</html>\n"
